# Temporary tldraw license (client-safe). Swap when permanent hobby key arrives.
PUBLIC_TLDRAW_LICENSE_KEY=

# Clerk (Phase 4b — Google sign-in + cloud libraries)
# Frontend (Astro inlines PUBLIC_* at build). Custom Clerk domain: clerk.scsfoxchase.tech
PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server / Worker only — never expose to the client. Set as:
#   npx wrangler secret put CLERK_SECRET_KEY
# and for local Worker preview, put the same value in `.dev.vars` (gitignored).
CLERK_SECRET_KEY=
# Optional school allowlist: comma-separated domains and/or full emails.
# Example: stceciliafc.com,you@gmail.com
# Empty = allow any Google account signed in via Clerk (still Google-only in Clerk UI).
PUBLIC_CLERK_ALLOWED_DOMAINS=stceciliafc.com

# Whiteboard sync: Durable Objects (WHITEBOARDS) — no extra env vars.
# Whiteboard assets + cloud library indexes: R2 binding WHITEBOARD_ASSETS
#   → bucket scsfoxchase-tech-whiteboards
#   Media: assets/{ownerKey}/{assetId}
#   Indexes: library/{ownerKey}/boards.json | assets.json
#   (Create once if missing: npx wrangler r2 bucket create scsfoxchase-tech-whiteboards)
#   Note: R2 names disallow `_`; product family remains scsfoxchase-tech_whiteboards.
