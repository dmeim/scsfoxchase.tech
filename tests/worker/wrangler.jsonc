{
	"name": "scsfoxchase-tech-worker-tests",
	"compatibility_date": "2026-07-14",
	"compatibility_flags": ["nodejs_compat"],
	"main": "../../src/worker.ts",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.05,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		}
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "WHITEBOARDS",
				"class_name": "WhiteboardBoard"
			}
		]
	},
	"ratelimits": [
		{
			"name": "FORM_SUBMISSION_LIMITER",
			"namespace_id": "2026083101",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "WHITEBOARD_CONNECT_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 600,
				"period": 60
			}
		},
		{
			"name": "WHITEBOARD_BOARD_CONNECT_LIMITER",
			"namespace_id": "2026083001",
			"simple": {
				"limit": 240,
				"period": 60
			}
		}
	],
	"migrations": [
		{
			"tag": "whiteboard-v1",
			"new_sqlite_classes": ["WhiteboardBoard"]
		}
	],
	"r2_buckets": [
		{
			"binding": "WHITEBOARD_ASSETS",
			"bucket_name": "scsfoxchase-tech-whiteboards-worker-tests"
		}
	],
	"kv_namespaces": [
		{
			"binding": "WHITEBOARD_CODES",
			"id": "whiteboard-codes-worker-tests"
		}
	],
	// Test workers use a local-only D1 database identity. It deliberately does
	// not reuse either remote production or preview UUID.
	"d1_databases": [
		{
			"binding": "WHITEBOARD_LIBRARY",
			"database_name": "scsfoxchase-tech-whiteboard-library-worker-tests",
			"database_id": "00000000-0000-4000-8000-000000000001",
			"remote": false,
			"migrations_dir": "../../migrations"
		},
		{
			"binding": "NOTIFICATIONS",
			"database_name": "scsfoxchase-tech-notifications-worker-tests",
			"database_id": "00000000-0000-4000-8000-000000000002",
			"remote": false,
			"migrations_dir": "../../notification-migrations"
		}
	]
}
