{
  "name": "scsfoxchase-tech",
  "version": "1.0.0",
  "type": "module",
  "description": "A static PWA serving as a dashboard and educational games catalog for St. Cecilia School. Used daily by students and teachers on desktops, Dell Chromebooks, and iPads.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "copy-excalidraw-fonts": "node scripts/copy-excalidraw-fonts.mjs",
    "predev": "npm run copy-excalidraw-fonts",
    "prebuild": "npm run copy-excalidraw-fonts",
    "postbuild": "node scripts/stamp-service-worker.mjs",
    "dev": "astro dev --host",
    "test": "vitest run",
    "typecheck:whiteboard": "tsc -p tsconfig.whiteboard.json",
    "verify:whiteboard": "npm run typecheck:whiteboard && npm test && npm run build",
    "build": "astro build",
    "preview": "astro preview",
    "preview:upload": "npm run verify:whiteboard && wrangler versions upload",
    "images:generate": "node scripts/generate-display-images.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@clerk/backend": "^3.21.0",
    "@clerk/react": "^6.17.3",
    "@excalidraw/excalidraw": "0.18.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "lucide": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.4",
    "@cloudflare/workers-types": "^5.20260930.2",
    "sharp": "0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "lodash-es": "4.18.1",
    "nanoid@<4": "3.3.19",
    "nanoid@>=4 <5.1.16": "5.1.16"
  }
}
