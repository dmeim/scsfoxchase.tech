---
import { tempNotifications } from '../data/temp-notifications';
import { ToastExample } from './ui';
---

<div class="temp-notification-lab">
  <section class="temp-notification-intro" aria-labelledby="temp-notification-title">
    <p class="temp-notification-eyebrow">Component mockup</p>
    <h2 id="temp-notification-title">Toast notifications</h2>
    <p class="temp-notification-lede">
      School-color status accents on a neutral Cream and Charcoal surface.
      These four samples are pinned for comparison; live toasts would dismiss
      after 10 seconds unless <code>persist: true</code> is passed.
    </p>

    <dl class="temp-notification-specs">
      <div>
        <dt>Content</dt>
        <dd>Icon, title, subtitle, description</dd>
      </div>
      <div>
        <dt>Behavior</dt>
        <dd>Stacked, dismissible, persistent when requested</dd>
      </div>
      <div>
        <dt>Notification center</dt>
        <dd>Use the bell beside Sign in to preview</dd>
      </div>
    </dl>
  </section>

  <section class="temp-toast-preview" aria-labelledby="temp-toast-preview-title">
    <div class="temp-toast-preview-head">
      <div>
        <p class="temp-notification-eyebrow">Persistent preview</p>
        <h3 id="temp-toast-preview-title">Toast stack</h3>
      </div>
      <span>4 notifications</span>
    </div>

    <div class="temp-toast-stack" aria-live="polite" data-temp-toast-stack>
      {tempNotifications.map((notification) => (
        <ToastExample
          kind={notification.kind}
          title={notification.title}
          subtitle={notification.subtitle}
          description={notification.description}
          class="temp-toast"
          data-temp-toast
          data-notification-id={notification.id}
          data-persist="true"
        />
      ))}
    </div>
  </section>
</div>

<script>
  import '../scripts/temp-notifications';
</script>
