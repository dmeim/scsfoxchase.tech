---
import { getCollection } from 'astro:content';
import trending from '../data/trending.json';
import { gameDisplayImages } from '../lib/display-images';
import { Button, ChipGroup, IconButton, ProgressTabs, SearchField } from './ui';
import { iconChevronLeft, iconChevronRight } from '../scripts/icons';
import GameDetailDialog from './GameDetailDialog.astro';
import GameCard from './GameCard.astro';

const games = (await getCollection('games')).map((entry) => gameDisplayImages(entry.data));
const trendingIds = trending as string[];
const catalogPayload = JSON.stringify({ games, trendingIds });

const trendingGames = trendingIds
  .map((id) => games.find((g) => g.id === id))
  .filter((g): g is (typeof games)[number] => Boolean(g));

const featured = trendingGames[0];
const heroPayload = JSON.stringify(trendingGames);
const gradeOptions = Array.from({ length: 8 }, (_, index) => ({ label: String(index + 1), value: String(index + 1) }));
const primaryCategories = [...new Set(games.flatMap((game) => game.primaryCategories || []))]
  .sort()
  .map((value) => ({ label: value, value }));
const secondaryCategories = [...new Set(games.flatMap((game) => game.secondaryCategories || game.categories || []))]
  .sort()
  .map((value) => ({ label: value, value }));
---

<section class="games-section newgames-layout">
  <div class="container">
    <div class="newgames-split">
      <aside class="newgames-sidebar" aria-label="Game filters">
        <div class="filter-container">
          <SearchField type="text" id="game-search" label="Search games" placeholder={`Search All ${games.length} Games...`} class="search-bar" autocomplete="off" />
          <Button variant="ghost" size="small" data-games-clear>Clear filters</Button>
          <div class="filter-group">
            <span class="filter-group-label">Grade</span>
            <ChipGroup id="grade-chips" class="filter-chips-row" chipClass="filter-chip" options={gradeOptions} selected={[]} multiple ariaLabel="Filter by grade" />
          </div>
          <div class="filter-group">
            <span class="filter-group-label">Type</span>
            <ChipGroup id="primary-category-chips" class="filter-chips-row" chipClass="filter-chip" options={primaryCategories} selected={[]} multiple ariaLabel="Filter by type" />
          </div>
          <div class="filter-group">
            <span class="filter-group-label">Genre</span>
            <ChipGroup id="secondary-category-chips" class="filter-chips-row" chipClass="filter-chip" options={secondaryCategories} selected={[]} multiple ariaLabel="Filter by genre" />
          </div>
        </div>
      </aside>

      <div class="newgames-main">
        {
          featured ? (
            <section class="ng-hero" data-ng-hero aria-label="Trending games">
              <a
                class="ng-hero-link"
                href={featured.url}
                target="_blank"
                rel="noopener noreferrer"
                data-ng-hero-link
              >
                <img class="ng-hero-bg" data-ng-hero-bg src={featured.image} alt="" decoding="async" fetchpriority="high" />
                <div class="ng-hero-body">
                  <h3 data-ng-hero-title>{featured.name}</h3>
                  <p data-ng-hero-desc>{featured.description}</p>
                </div>
              </a>
              <div class="ng-hero-pager">
                <Button variant="glass" size="small" data-ng-hero-pause aria-label="Pause trending rotation" aria-pressed="false">Pause</Button>
                <div class="ng-hero-pager-btns">
                  <IconButton icon={iconChevronLeft} label="Previous" size="small" data-ng-hero-prev />
                  <IconButton icon={iconChevronRight} label="Next" size="small" data-ng-hero-next />
                </div>
                <ProgressTabs
                  options={trendingGames.map((game) => ({ label: `Show ${game.name}`, value: game.id }))}
                  selected={featured.id}
                  ariaLabel="Trending slides"
                  class="ng-hero-progress"
                  tabClass="ng-hero-progress-seg"
                  fillClass="ng-hero-progress-fill"
                  data-ng-hero-progress
                />
              </div>
            </section>
          ) : null
        }

        <div class="games-grid games-grid--max" id="games-grid" data-card-style="max">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      </div>
    </div>
  </div>
</section>

<GameDetailDialog />

<script type="application/json" id="games-catalog-data" set:html={catalogPayload} />
<script type="application/json" id="ng-hero-data" set:html={heroPayload} />

<script>
  import { initGamesCatalog } from '../scripts/games-catalog';

  const dataEl = document.getElementById('games-catalog-data');
  if (dataEl?.textContent) {
    const { games, trendingIds } = JSON.parse(dataEl.textContent) as {
      games: Parameters<typeof initGamesCatalog>[0];
      trendingIds: string[];
    };
    // Filters + grid only — no #trending-carousel; hero is handled below.
    initGamesCatalog(games, trendingIds);
  }

  import { initTrendingHero } from '../scripts/trending-hero';
  initTrendingHero();
</script>
