---
import { getCollection } from 'astro:content';
import trending from '../data/trending.json';
import { ChipGroup, IconButton, ProgressTabs, SearchField } from './ui';
import { iconChevronLeft, iconChevronRight } from '../scripts/icons';
import GameDetailDialog from './GameDetailDialog.astro';

const games = (await getCollection('games')).map((entry) => entry.data);
const trendingIds = trending as string[];
const catalogPayload = JSON.stringify({ games, trendingIds });

const trendingGames = trendingIds
  .map((id) => games.find((g) => g.id === id))
  .filter((g): g is (typeof games)[number] => Boolean(g));

const featured = trendingGames[0];
const heroPayload = JSON.stringify(trendingGames);
const gradeOptions = Array.from({ length: 8 }, (_, index) => ({ label: String(index + 1), value: String(index + 1) }));
const primaryCategories = [...new Set(games.flatMap((game) => game.primaryCategories || []))]
  .sort()
  .map((value) => ({ label: value, value }));
const secondaryCategories = [...new Set(games.flatMap((game) => game.secondaryCategories || game.categories || []))]
  .sort()
  .map((value) => ({ label: value, value }));
---

<section class="games-section newgames-layout">
  <div class="container">
    <div class="newgames-split">
      <aside class="newgames-sidebar" aria-label="Game filters">
        <div class="filter-container">
          <SearchField type="text" id="game-search" label="Search games" placeholder={`Search All ${games.length} Games...`} class="search-bar" autocomplete="off" />
          <div class="filter-group">
            <span class="filter-group-label">Grade</span>
            <ChipGroup id="grade-chips" class="filter-chips-row" chipClass="filter-chip" options={gradeOptions} selected={[]} multiple ariaLabel="Filter by grade" />
          </div>
          <div class="filter-group">
            <span class="filter-group-label">Type</span>
            <ChipGroup id="primary-category-chips" class="filter-chips-row" chipClass="filter-chip" options={primaryCategories} selected={[]} multiple ariaLabel="Filter by type" />
          </div>
          <div class="filter-group">
            <span class="filter-group-label">Genre</span>
            <ChipGroup id="secondary-category-chips" class="filter-chips-row" chipClass="filter-chip" options={secondaryCategories} selected={[]} multiple ariaLabel="Filter by genre" />
          </div>
        </div>
      </aside>

      <div class="newgames-main">
        {
          featured ? (
            <section class="ng-hero" data-ng-hero aria-label="Trending games">
              <a
                class="ng-hero-link"
                href={featured.url}
                target="_blank"
                rel="noopener noreferrer"
                data-ng-hero-link
              >
                <div
                  class="ng-hero-bg"
                  data-ng-hero-bg
                  style={`background-image:url('${featured.image}')`}
                />
                <div class="ng-hero-body">
                  <h3 data-ng-hero-title>{featured.name}</h3>
                  <p data-ng-hero-desc>{featured.description}</p>
                </div>
              </a>
              <div class="ng-hero-pager">
                <div class="ng-hero-pager-btns">
                  <IconButton icon={iconChevronLeft} label="Previous" size="small" data-ng-hero-prev />
                  <IconButton icon={iconChevronRight} label="Next" size="small" data-ng-hero-next />
                </div>
                <ProgressTabs
                  options={trendingGames.map((game) => ({ label: `Show ${game.name}`, value: game.id }))}
                  selected={featured.id}
                  ariaLabel="Trending slides"
                  class="ng-hero-progress"
                  tabClass="ng-hero-progress-seg"
                  fillClass="ng-hero-progress-fill"
                  data-ng-hero-progress
                />
              </div>
            </section>
          ) : null
        }

        <div class="games-grid games-grid--max" id="games-grid" data-card-style="max">
          <div class="loading-container">
            <div class="loading-spinner"></div>
            <p>Loading games...</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<GameDetailDialog />

<script type="application/json" id="games-catalog-data" set:html={catalogPayload} />
<script type="application/json" id="ng-hero-data" set:html={heroPayload} />

<script>
  import { initGamesCatalog } from '../scripts/games-catalog';

  const dataEl = document.getElementById('games-catalog-data');
  if (dataEl?.textContent) {
    const { games, trendingIds } = JSON.parse(dataEl.textContent) as {
      games: Parameters<typeof initGamesCatalog>[0];
      trendingIds: string[];
    };
    // Filters + grid only — no #trending-carousel; hero is handled below.
    initGamesCatalog(games, trendingIds);
  }

  type HeroGame = {
    id: string;
    name: string;
    url: string;
    image: string;
    description: string;
  };

  const heroEl = document.getElementById('ng-hero-data');
  const heroGames: HeroGame[] = heroEl?.textContent ? JSON.parse(heroEl.textContent) : [];
  const root = document.querySelector<HTMLElement>('[data-ng-hero]');

  if (root && heroGames.length > 0) {
    const AUTO_MS = 5000;
    const bg = root.querySelector<HTMLElement>('[data-ng-hero-bg]');
    const title = root.querySelector('[data-ng-hero-title]');
    const desc = root.querySelector('[data-ng-hero-desc]');
    const link = root.querySelector<HTMLAnchorElement>('[data-ng-hero-link]');
    const progress = root.querySelector<HTMLElement>('[data-ng-hero-progress]');
    let index = 0;
    let timer: ReturnType<typeof setTimeout> | null = null;

    if (progress) {
      progress.style.setProperty('--ng-hero-autoplay', `${AUTO_MS}ms`);
      if (heroGames.length <= 1) {
        progress.hidden = true;
      } else {
        progress.querySelectorAll<HTMLButtonElement>('[data-ui-progress-tab]').forEach((btn, i) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            go(i);
            restart();
          });
        });
      }
    }

    const paint = () => {
      const g = heroGames[index]!;
      if (bg) bg.style.backgroundImage = `url('${g.image}')`;
      if (title) title.textContent = g.name;
      if (desc) desc.textContent = g.description;
      if (link) {
        link.href = g.url;
        link.setAttribute('aria-label', `Play ${g.name}`);
      }

      progress?.querySelectorAll<HTMLButtonElement>('.ng-hero-progress-seg').forEach((seg, i) => {
        const fill = seg.querySelector<HTMLElement>('.ng-hero-progress-fill');
        const active = i === index;
        seg.classList.toggle('is-active', active);
        seg.setAttribute('aria-selected', String(active));
        seg.tabIndex = active ? 0 : -1;
        if (active) seg.setAttribute('aria-current', 'true');
        else seg.removeAttribute('aria-current');
        // Reset fill so only the current segment restarts its animation.
        fill?.classList.remove('is-animating');
      });
    };

    const go = (i: number) => {
      index = (i + heroGames.length) % heroGames.length;
      paint();
    };

    const restart = () => {
      if (timer) clearTimeout(timer);
      timer = null;
      if (heroGames.length <= 1) return;

      const active = progress?.querySelector<HTMLElement>(
        '.ng-hero-progress-seg.is-active .ng-hero-progress-fill',
      );
      if (active) {
        // Force a reflow so removing/adding is-animating restarts the fill.
        void active.offsetWidth;
        active.classList.add('is-animating');
      }

      timer = setTimeout(() => {
        go(index + 1);
        restart();
      }, AUTO_MS);
    };

    root.querySelector('[data-ng-hero-prev]')?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      go(index - 1);
      restart();
    });
    root.querySelector('[data-ng-hero-next]')?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      go(index + 1);
      restart();
    });

    paint();
    restart();
  }
</script>
