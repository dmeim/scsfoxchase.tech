    icon: '/images/new-google-drive.svg',
    placeholder: 'Search Drive files…',
    url: 'https://drive.google.com/drive/u/0/search?q={query}',
    hint: 'Files',
  },
  {
    label: 'Docs',
    icon: '/images/new-google-docs.svg',
    placeholder: 'Search Docs…',
    url: 'https://docs.google.com/document/u/0/?tgif=d&q={query}',
    hint: 'Writing',
  },
  {
    label: 'Slides',
    icon: '/images/new-google-slides.svg',
    placeholder: 'Search Slides…',
    url: 'https://docs.google.com/presentation/u/0/?tgif=d&q={query}',
    hint: 'Presentations',
  },
