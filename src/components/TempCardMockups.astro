  { group: 'School tools', option: schoolOptions[0] },
];

const railRoutes = [
  { group: 'Google', option: googleOptions[0] },
  { group: 'Workspace', option: workspaceOptions[0] },
  { group: 'School tools', option: schoolOptions[0] },
  { group: 'Research', option: researchOptions[0] },
