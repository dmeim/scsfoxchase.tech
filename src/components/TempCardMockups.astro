                <img src={route.option.icon} alt="" /><span>{route.group}</span>
              </button>
            ))}
            <span class="temp-rail-rule" aria-hidden="true"></span>
            <span class="temp-rail-more" aria-hidden="true">＋</span>
          </nav>
          <div class="temp-rail-main">
            <div class="temp-rail-input-row">
              <span class="temp-rail-current"><img src={googleOptions[0].icon} alt="" data-temp-selected-icon /></span>
              <input class="temp-search-input" type="search" name="q" placeholder={googleOptions[0].placeholder} aria-label="Search selected source" autocomplete="off" />
              <button type="button" class="temp-clear-button" data-temp-clear aria-label="Clear search">×</button>
              <button type="submit" class="temp-submit-button" aria-label="Search selected source"><span>Search</span><b>↗</b></button>
            </div>
          </div>
        </form>
      </div>
    </section>

    <!-- Candidate 6 -->
