        <form class="temp-search-form temp-shelf-form" id="temp-shelf-form" data-temp-search-form data-selected-url={googleOptions[0].url}>
          <div class="temp-shelf-input-row">
            <span class="temp-shelf-search-icon" aria-hidden="true">⌕</span>
            <input class="temp-search-input" type="search" name="q" placeholder="What do you need today?" aria-label="Search everything" autocomplete="off" />
            <button type="button" class="temp-clear-button" data-temp-clear aria-label="Clear search">×</button>
            <button type="submit" class="temp-shelf-submit" aria-label="Search"><span>Search</span><b>↗</b></button>
          </div>
        </form>
      </div>
    </section>




    <!-- Candidate 9 -->
    <section class="temp-candidate" id="candidate-9">
      <div class="temp-stage temp-stage--explorer">
        <form class="temp-search-form temp-explorer-form" id="temp-explorer-form" data-temp-search-form data-selected-url={googleOptions[0].url}>
          <div class="temp-explorer-panel" role="listbox" aria-label="Nested search destinations">
            {nestedGroups.map((group, groupIndex) => (
              <div class="temp-explorer-group"><div class="temp-explorer-group-head"><span class="temp-explorer-group-dot"></span><strong>{group.label}</strong><span>{group.options.length}</span></div>{group.options.map((option, optionIndex) => (<button type="button" role="option" class:list={['temp-explorer-option', groupIndex === 0 && optionIndex === 0 && 'is-selected']} aria-selected={groupIndex === 0 && optionIndex === 0 ? 'true' : 'false'} data-temp-option data-label={option.label} data-group={group.label} data-icon={option.icon} data-placeholder={option.placeholder} data-url={option.url}><img src={option.icon} alt="" /><span>{option.label}</span><b>↗</b></button>))}</div>
            ))}
          </div>
          <div class="temp-explorer-input"><span class="temp-explorer-search-mark">⌕</span><input class="temp-search-input" type="search" name="q" placeholder={googleOptions[0].placeholder} aria-label="Search selected destination" autocomplete="off" /><button type="button" class="temp-clear-button" data-temp-clear aria-label="Clear search">×</button><button type="submit" class="temp-submit-button" aria-label="Search selected destination"><span>Search</span><b>↗</b></button></div>
        </form>
      </div>
    </section>



    <!-- Candidate 11 -->
    <section class="temp-candidate" id="candidate-11">
      <div class="temp-stage temp-stage--shelf-command">
        <form class="temp-search-form temp-shelf-command-form" id="temp-shelf-command-form" data-temp-search-form data-selected-url={googleOptions[0].url}>
          <div class="temp-shelf-command-bar">
            <div class="temp-menu-wrap temp-shelf-command-menu-wrap">
              <button type="button" class="temp-command-prefix temp-shelf-command-prefix" data-temp-menu-toggle aria-haspopup="listbox" aria-expanded="false" aria-label="Choose a search destination">
                <img src={googleOptions[0].icon} alt="" data-temp-selected-icon />
                <span data-temp-selected-group>Google</span><i>›</i><strong data-temp-selected-label>Web</strong><span class="temp-chevron" aria-hidden="true">⌄</span>
              </button>
              <div class="temp-menu temp-menu--command" data-temp-menu role="listbox" aria-label="Search destinations">
                <div class="temp-menu-columns">
                  {nestedGroups.map((group, groupIndex) => (
                    <div class="temp-menu-group">
                      <p>{group.label}</p>
                      {group.options.map((option, optionIndex) => (
                        <button type="button" role="option" class:list={['temp-option', groupIndex === 0 && optionIndex === 0 && 'is-selected']} aria-selected={groupIndex === 0 && optionIndex === 0 ? 'true' : 'false'} data-temp-option data-label={option.label} data-group={group.label} data-icon={option.icon} data-placeholder={option.placeholder} data-url={option.url}>
                          <img src={option.icon} alt="" /><span>{option.label}</span>
                        </button>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <span class="temp-shelf-search-icon" aria-hidden="true">⌕</span>
            <input class="temp-search-input" type="search" name="q" placeholder={googleOptions[0].placeholder} aria-label="Search selected destination" autocomplete="off" />
            <button type="button" class="temp-clear-button" data-temp-clear aria-label="Clear search">×</button>
            <button type="submit" class="temp-shelf-submit" aria-label="Search selected destination"><span>Search</span><b>↗</b></button>
          </div>
        </form>
      </div>
    </section>

    <!-- Candidate 12 -->
    <section class="temp-candidate" id="candidate-12">
      <div class="temp-stage temp-stage--shelf-tabs">
        <form class="temp-search-form temp-shelf-tabs-form" id="temp-shelf-tabs-form" data-temp-search-form data-selected-url={workspaceOptions[0].url}>
          <div class="temp-shelf-tabs" role="tablist" aria-label="Search source">
            {tabRoutes.map((route, index) => (
              <button type="button" role="tab" class:list={['temp-shelf-tab', index === 0 && 'is-selected']} aria-selected={index === 0 ? 'true' : 'false'} data-temp-option data-label={route.option.label} data-group={route.group} data-icon={route.option.icon} data-placeholder={route.option.placeholder} data-url={route.option.url}>
                <img src={route.option.icon} alt="" /><span>{route.group}</span><b>{index === 0 ? '01' : index === 1 ? '02' : '03'}</b>
              </button>
            ))}
          </div>
          <div class="temp-shelf-tabs-input-row">
            <div class="temp-shelf-tabs-current"><img src={workspaceOptions[0].icon} alt="" data-temp-selected-icon /><span><small data-temp-selected-group>Workspace</small><strong data-temp-selected-label>Drive</strong></span></div>
            <span class="temp-shelf-search-icon" aria-hidden="true">⌕</span>
            <input class="temp-search-input" type="search" name="q" placeholder={workspaceOptions[0].placeholder} aria-label="Search selected source" autocomplete="off" />
            <button type="button" class="temp-clear-button" data-temp-clear aria-label="Clear search">×</button>
            <button type="submit" class="temp-shelf-submit" aria-label="Search selected source"><span>Search</span><b>↗</b></button>
          </div>
        </form>
      </div>
    </section>

  </div>
</div>

<script>
  function initTempSearch() {
    const forms = Array.from(document.querySelectorAll('[data-temp-search-form]'));

    const closeMenus = () => {
      document.querySelectorAll('[data-temp-menu].is-open').forEach((menu) => {
        menu.classList.remove('is-open');
        const toggle = menu.parentElement?.querySelector('[data-temp-menu-toggle]');
        toggle?.setAttribute('aria-expanded', 'false');
      });
    };

    forms.forEach((form) => {
      const input = form.querySelector('input[data-temp-search-input], .temp-search-input');
      if (!(input instanceof HTMLInputElement)) return;

      const options = Array.from(form.querySelectorAll('[data-temp-option]'));
      const menu = form.querySelector('[data-temp-menu]');
      const toggle = form.querySelector('[data-temp-menu-toggle]');

      const selectOption = (option) => {
        const data = option.dataset;
        form.dataset.selectedUrl = data.url || '';

        form.querySelectorAll('[data-temp-selected-label]').forEach((element) => {
          element.textContent = data.label || '';
        });
        form.querySelectorAll('[data-temp-selected-group]').forEach((element) => {
          element.textContent = data.group || '';
        });
        form.querySelectorAll('[data-temp-selected-icon]').forEach((element) => {
          if (element instanceof HTMLImageElement && data.icon) element.src = data.icon;
        });
        if (data.placeholder) input.placeholder = data.placeholder;

        options.forEach((item) => {
          const selected = item === option;
          item.classList.toggle('is-selected', selected);
          item.setAttribute('aria-selected', String(selected));
          if (item.getAttribute('role') === 'tab') item.setAttribute('aria-selected', String(selected));
          if (item.hasAttribute('aria-pressed')) item.setAttribute('aria-pressed', String(selected));
        });
      };

      const initialOption = options.find((option) => option.classList.contains('is-selected')) || options[0];
      if (initialOption) selectOption(initialOption);

      options.forEach((option) => {
        option.addEventListener('click', () => {
          selectOption(option);
          closeMenus();
          input.focus();
        });
      });

      if (menu && toggle) {
        const setMenuOpen = (open, focusFirst = false) => {
          closeMenus();
          menu.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', String(open));
          if (open && focusFirst) options.find((option) => option.dataset.tempOption !== undefined)?.focus();
        };

        toggle.addEventListener('click', () => {
          setMenuOpen(!menu.classList.contains('is-open'));
        });

        toggle.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown') {
            event.preventDefault();
            setMenuOpen(true, true);
          }
        });

        menu.addEventListener('keydown', (event) => {
          const menuOptions = options.filter((option) => menu.contains(option));
          const currentIndex = menuOptions.indexOf(document.activeElement as HTMLButtonElement);
          if (event.key === 'Escape') {
            event.preventDefault();
            closeMenus();
            toggle.focus();
            return;
          }
          if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' && event.key !== 'Home' && event.key !== 'End') return;
          event.preventDefault();
          const nextIndex = event.key === 'Home'
            ? 0
            : event.key === 'End'
              ? menuOptions.length - 1
              : Math.max(0, Math.min(menuOptions.length - 1, currentIndex + (event.key === 'ArrowDown' ? 1 : -1)));
          menuOptions[nextIndex]?.focus();
        });
      }

      form.querySelector('[data-temp-clear]')?.addEventListener('click', () => {
        input.value = '';
        input.focus();
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const query = input.value.trim();
        const url = form.dataset.selectedUrl || '';
        if (!query || !url) {
          input.focus();
          return;
        }
        window.open(url.replace('{query}', encodeURIComponent(query)), '_blank', 'noopener,noreferrer');
      });
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('.temp-menu-wrap')) closeMenus();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeMenus();
        return;
      }

      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        const activeForm = document.activeElement?.closest('[data-temp-search-form]');
        const commandForm = activeForm?.matches('.temp-command-form, .temp-shelf-command-form')
          ? activeForm
          : document.querySelector('#temp-command-form');
        const commandInput = commandForm?.querySelector('.temp-search-input');
        if (commandInput instanceof HTMLInputElement) {
          event.preventDefault();
          commandInput.focus();
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTempSearch, { once: true });
  } else {
    initTempSearch();
  }
</script>
