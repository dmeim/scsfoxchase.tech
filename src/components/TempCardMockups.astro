---

<div class="temp-page temp-search-page" id="top">
  <div class="temp-shell">

    <!-- Unified homepage-style search -->
    <section class="temp-candidate" id="unified-home-search">
      <div class="temp-stage temp-stage--home-search">
        <form class="temp-search-form temp-home-search-form" id="temp-command-form" data-temp-search-form data-selected-url={googleOptions[0].url}>
          <div class="temp-home-search-bar">
            <div class="temp-menu-wrap temp-home-menu-wrap">
              <button type="button" class="temp-home-picker" data-temp-menu-toggle aria-haspopup="listbox" aria-expanded="false" aria-label="Choose a search destination">
                <img src={googleOptions[0].icon} alt="" data-temp-selected-icon />
                <strong data-temp-selected-label>Web</strong>
                <svg class="temp-home-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
              </button>
              <div class="temp-menu temp-home-menu" data-temp-menu role="listbox" aria-label="Search destinations">
                <div class="temp-home-menu-columns">
                  {homepageSearchGroups.map((group, groupIndex) => (
                    <div class="temp-home-menu-group" role="group" aria-labelledby={`temp-home-group-${groupIndex}`}>
                      <p id={`temp-home-group-${groupIndex}`}>{group.label}</p>
                      {group.options.map((option, optionIndex) => (
                        <button type="button" role="option" class:list={['temp-home-option', groupIndex === 0 && optionIndex === 0 && 'is-selected']} aria-selected={groupIndex === 0 && optionIndex === 0 ? 'true' : 'false'} data-temp-option data-label={option.label} data-group={group.label} data-icon={option.icon} data-placeholder={option.placeholder} data-url={option.url}>
                          <img src={option.icon} alt="" /><span>{option.label}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
                        </button>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <span class="temp-home-bar-separator" aria-hidden="true"></span>
            <input class="temp-search-input temp-home-search-input" type="search" name="q" placeholder={googleOptions[0].placeholder} aria-label="Search the selected destination" autocomplete="off" />
            <button type="button" class="temp-clear-button temp-home-clear" data-temp-clear aria-label="Clear search"><img src="/images/x.svg" alt="" /></button>
            <button type="submit" class="temp-home-submit" aria-label="Search selected destination"><img src="/images/search.png" alt="" /></button>
          </div>
        </form>
      </div>
    </section>

    <!-- Candidate 3 -->
    <section class="temp-candidate" id="candidate-3">
      <div class="temp-stage temp-stage--tabs">
        <form class="temp-search-form temp-tabs-form" id="temp-tabs-form" data-temp-search-form data-selected-url={workspaceOptions[0].url}>
          <div class="temp-tabs" role="tablist" aria-label="Search source">
            {tabRoutes.map((route, index) => (
              <button type="button" role="tab" class:list={['temp-tab', index === 0 && 'is-selected']} aria-selected={index === 0 ? 'true' : 'false'} data-temp-option data-label={route.option.label} data-group={route.group} data-icon={route.option.icon} data-placeholder={route.option.placeholder} data-url={route.option.url}>
                <img src={route.option.icon} alt="" /><span>{route.group}</span><b>{index === 0 ? '⌘1' : index === 1 ? '⌘2' : '⌘3'}</b>
              </button>
            ))}
          </div>
          <div class="temp-tab-input-row">
            <div class="temp-tab-current"><img src={workspaceOptions[0].icon} alt="" data-temp-selected-icon /><span><small>Current destination</small><strong data-temp-selected-label>Drive</strong></span></div>
            <input class="temp-search-input" type="search" name="q" placeholder={workspaceOptions[0].placeholder} aria-label="Search selected source" autocomplete="off" />
            <button type="button" class="temp-clear-button" data-temp-clear aria-label="Clear search">×</button>
            <button type="submit" class="temp-submit-button" aria-label="Search selected source"><span>Search</span><b>↗</b></button>
          </div>
        </form>
      </div>
    </section>


    <!-- Candidate 5 -->
