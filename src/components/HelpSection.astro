---
import { ActionTile, Button } from './ui';
interface Props {
  title: string;
  viewAllHref?: string;
  viewAllLabel?: string;
  tiles: {
    href: string;
    label: string;
    iconHtml: string;
    statusLabel?: string;
  }[];
  emptyMessage?: string;
  ariaLabel?: string;
  /** When false, omit the section title (catalog pages already have a page heading). */
  showTitle?: boolean;
}

const {
  title,
  viewAllHref,
  viewAllLabel = 'View All',
  tiles,
  emptyMessage = 'Nothing here yet.',
  ariaLabel = title,
  showTitle = true,
} = Astro.props;
---
<section class="help-section" aria-label={ariaLabel}>
  {
    (showTitle || viewAllHref) && (
      <div class="help-section-header">
        {showTitle ? <h2 class="help-section-title">{title}</h2> : <span />}
        {
          viewAllHref && (
            <Button href={viewAllHref} variant="outline" size="small" class="help-view-all">{viewAllLabel}</Button>
          )
        }
      </div>
    )
  }

  {
    tiles.length === 0 ? (
      <p class="help-empty">{emptyMessage}</p>
    ) : (
      <div class="forms-grid">
        {tiles.map((tile) => (
          <ActionTile
            href={tile.href}
            class="forms-tile"
            iconClass="forms-tile-icon"
            titleClass="forms-tile-label"
            icon={tile.iconHtml}
            title={tile.label}
            description={tile.statusLabel}
          />
        ))}
      </div>
    )
  }
</section>
