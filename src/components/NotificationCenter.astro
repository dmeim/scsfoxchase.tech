---
import { iconBell, iconTrash2 } from '../scripts/icons';
---
<div class="notification-center" data-notification-center>
  <button
    type="button"
    class="notification-trigger"
    data-notification-trigger
    aria-label="Notifications"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="notification-center-panel"
  >
    <span class="notification-trigger-icon" set:html={iconBell} />
    <span class="notification-badge" data-notification-badge hidden>0</span>
  </button>
  <section
    class="notification-panel"
    id="notification-center-panel"
    data-notification-panel
    role="dialog"
    aria-label="Notifications"
    hidden
  >
    <div class="notification-panel-head">
      <h2>Notifications</h2>
      <button type="button" class="notification-clear" data-notification-clear disabled>
        <span set:html={iconTrash2} />
        Clear All
      </button>
    </div>
    <ul class="notification-list" data-notification-list hidden></ul>
    <p class="notification-empty" data-notification-empty>No notifications yet.</p>
  </section>
</div>
