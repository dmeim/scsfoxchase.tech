---
import './styles.css';

interface Props {
  as?: 'article' | 'section' | 'div' | 'li';
  href?: string;
  interactive?: boolean;
  transparent?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  as = 'div',
  href,
  interactive = Boolean(href),
  transparent = false,
  class: className,
  ...rest
} = Astro.props;
const Tag = href ? 'a' : as;
---

<Tag
  class:list={[
    'ui-card',
    interactive && 'ui-card--interactive',
    transparent && 'ui-card--transparent',
    className,
  ]}
  href={href}
  {...rest}
>
  <slot />
</Tag>
