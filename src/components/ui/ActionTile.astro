---
import './styles.css';

interface Props {
  title: string;
  description?: string;
  icon: string;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  iconClass?: string;
  titleClass?: string;
  class?: string;
  [key: string]: any;
}

const {
  title,
  description,
  icon,
  href,
  type = 'button',
  iconClass,
  titleClass,
  class: className,
  ...rest
} = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['ui-card', 'ui-card--tile', className]}
  href={href}
  type={href ? undefined : type}
  {...rest}
>
  <span class:list={['ui-card-icon', 'ui-card-icon--large', iconClass]} set:html={icon}></span>
  <strong class={titleClass}>{title}</strong>
  {description && <small>{description}</small>}
</Tag>
