---
import './styles.css';

interface Props {
  label: string;
  description?: string;
  name?: string;
  value?: string;
  placeholder?: string;
  rows?: number;
  required?: boolean;
  disabled?: boolean;
  labelHidden?: boolean;
  textareaClass?: string;
  class?: string;
  [key: string]: any;
}

const {
  label,
  description,
  value,
  rows = 5,
  labelHidden = false,
  textareaClass,
  class: className,
  ...textareaProps
} = Astro.props;
---

<label class:list={['ui-field', labelHidden && 'ui-field--label-hidden', className]}>
  <span>{label}</span>
  {description && <small>{description}</small>}
  <textarea class:list={['ui-field-control', textareaClass]} rows={rows} {...textareaProps}>{value}</textarea>
</label>
