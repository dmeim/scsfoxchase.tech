---
import './styles.css';

interface Props {
  label: string;
  description?: string;
  name?: string;
  type?: 'text' | 'email' | 'password' | 'url' | 'tel' | 'number';
  value?: string | number;
  placeholder?: string;
  autocomplete?: string;
  required?: boolean;
  disabled?: boolean;
  labelHidden?: boolean;
  inputClass?: string;
  wrapperHidden?: boolean;
  class?: string;
  [key: string]: any;
}

const {
  label,
  description,
  type = 'text',
  labelHidden = false,
  inputClass,
  wrapperHidden = false,
  class: className,
  ...inputProps
} = Astro.props;
---

<label class:list={['ui-field', labelHidden && 'ui-field--label-hidden', className]} hidden={wrapperHidden}>
  <span>{label}</span>
  {description && <small>{description}</small>}
  <input class:list={['ui-field-control', inputClass]} type={type} {...inputProps} />
</label>
