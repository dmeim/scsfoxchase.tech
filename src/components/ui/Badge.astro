---
import type { BadgeTone } from './types';
import './styles.css';

interface Props {
  tone?: BadgeTone;
  class?: string;
  [key: string]: any;
}

const { tone = 'normal', class: className, ...rest } = Astro.props;
---

<span class:list={['ui-badge', `ui-badge--${tone}`, className]} {...rest}><slot /></span>
