---
import type { BadgeTone } from './types';
import './styles.css';

interface Props {
  tone?: BadgeTone;
  href?: string;
  class?: string;
  [key: string]: any;
}

const { tone = 'normal', href, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['ui-badge', `ui-badge--${tone}`, className]} href={href} {...rest}><slot /></Tag>
