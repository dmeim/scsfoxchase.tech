---
import { iconSearch } from '../../scripts/icons';
import './styles.css';

interface Props {
  label: string;
  name?: string;
  value?: string;
  placeholder?: string;
  disabled?: boolean;
  icon?: string;
  inputClass?: string;
  type?: 'search' | 'text';
  class?: string;
  [key: string]: any;
}

const {
  label,
  icon = iconSearch,
  inputClass,
  type = 'search',
  class: className,
  ...inputProps
} = Astro.props;
---

<label class:list={['ui-search-field', className]}>
  {icon && <span set:html={icon}></span>}
  <input class:list={['ui-search-field-input', inputClass]} type={type} aria-label={label} {...inputProps} />
</label>
