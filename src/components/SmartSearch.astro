---
---
<section class="google-search-row">
  <div class="container">
    <div class="google-search-bars smart-search-bars-titled">
      <div class="smart-search-field">
        <div class="smart-search-title">G-Suite</div>
        <form class="google-search-bar smart-search-bar" data-smart-search target="_blank" rel="noopener noreferrer">
          <div class="smart-search-picker">
            <button type="button" class="smart-search-toggle" aria-haspopup="listbox" aria-expanded="false">
              <img src="/images/new-google-drive.svg" alt="" class="smart-search-icon">
              <span class="smart-search-label">Drive</span>
              <svg class="icon-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="0.65em" height="0.65em" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="smart-search-menu" role="listbox">
              <button type="button" role="option" class="smart-search-option active" data-label="Drive" data-icon="/images/new-google-drive.svg" data-placeholder="Search Drive..." data-url="https://drive.google.com/drive/u/0/search?q={query}"><img src="/images/new-google-drive.svg" alt="">Drive</button>
              <button type="button" role="option" class="smart-search-option" data-label="Docs" data-icon="/images/new-google-docs.svg" data-placeholder="Search Docs..." data-url="https://docs.google.com/document/u/0/?tgif=d&q={query}"><img src="/images/new-google-docs.svg" alt="">Docs</button>
              <button type="button" role="option" class="smart-search-option" data-label="Slides" data-icon="/images/new-google-slides.svg" data-placeholder="Search Slides..." data-url="https://docs.google.com/presentation/u/0/?tgif=d&q={query}"><img src="/images/new-google-slides.svg" alt="">Slides</button>
              <button type="button" role="option" class="smart-search-option" data-label="Sheets" data-icon="/images/new-google-sheets.svg" data-placeholder="Search Sheets..." data-url="https://docs.google.com/spreadsheets/u/0/?tgif=d&q={query}"><img src="/images/new-google-sheets.svg" alt="">Sheets</button>
              <button type="button" role="option" class="smart-search-option" data-label="Gmail" data-icon="/images/new-gmail.svg" data-placeholder="Search Gmail..." data-url="https://mail.google.com/mail/u/0/#search/{query}"><img src="/images/new-gmail.svg" alt="">Gmail</button>
              <button type="button" role="option" class="smart-search-option" data-label="Calendar" data-icon="/images/new-google-calendar.svg" data-placeholder="Search Calendar..." data-url="https://calendar.google.com/calendar/u/0/r/search?q={query}"><img src="/images/new-google-calendar.svg" alt="">Calendar</button>
            </div>
          </div>
          <span class="smart-search-separator" aria-hidden="true">|</span>
          <input type="text" name="q" placeholder="Search Drive..." class="google-search-input smart-search-input">
          <button type="button" class="google-search-clear" onclick="this.previousElementSibling.value='';this.previousElementSibling.focus()"><img src="/images/x.svg" alt="Clear"></button>
          <button type="submit" class="google-search-btn"><img src="/images/search.png" alt="Search"></button>
        </form>
      </div>
      <div class="smart-search-field">
        <div class="smart-search-title">Google</div>
        <form class="google-search-bar smart-search-bar" data-smart-search target="_blank" rel="noopener noreferrer">
          <div class="smart-search-picker">
            <button type="button" class="smart-search-toggle" aria-haspopup="listbox" aria-expanded="false">
              <img src="/images/new-google.svg" alt="" class="smart-search-icon">
              <span class="smart-search-label">Web</span>
              <svg class="icon-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="0.65em" height="0.65em" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="smart-search-menu" role="listbox">
              <button type="button" role="option" class="smart-search-option active" data-label="Web" data-icon="/images/new-google.svg" data-placeholder="Search Google Web..." data-url="https://www.google.com/search?udm=web&q={query}"><img src="/images/new-google.svg" alt="">Web</button>
              <button type="button" role="option" class="smart-search-option" data-label="Image" data-icon="/images/google-lens.svg" data-placeholder="Search Images..." data-url="https://www.google.com/search?udm=2&q={query}"><img src="/images/google-lens.svg" alt="">Image</button>
              <button type="button" role="option" class="smart-search-option" data-label="Videos" data-icon="/images/google-video-search.svg" data-placeholder="Search Videos..." data-url="https://www.google.com/search?tbm=vid&q={query}"><img src="/images/google-video-search.svg" alt="">Videos</button>
              <button type="button" role="option" class="smart-search-option" data-label="Books" data-icon="/images/google-books-search.svg" data-placeholder="Search Books..." data-url="https://www.google.com/search?tbm=bks&q={query}"><img src="/images/google-books-search.svg" alt="">Books</button>
              <button type="button" role="option" class="smart-search-option" data-label="News" data-icon="/images/google-news.svg" data-placeholder="Search News..." data-url="https://www.google.com/search?tbm=nws&q={query}"><img src="/images/google-news.svg" alt="">News</button>
              <button type="button" role="option" class="smart-search-option" data-label="Maps" data-icon="/images/new-google-maps.svg" data-placeholder="Search Maps..." data-url="https://www.google.com/maps/search/{query}"><img src="/images/new-google-maps.svg" alt="">Maps</button>
            </div>
          </div>
          <span class="smart-search-separator" aria-hidden="true">|</span>
          <input type="text" name="q" placeholder="Search Google Web..." class="google-search-input smart-search-input">
          <button type="button" class="google-search-clear" onclick="this.previousElementSibling.value='';this.previousElementSibling.focus()"><img src="/images/x.svg" alt="Clear"></button>
          <button type="submit" class="google-search-btn"><img src="/images/search.png" alt="Search"></button>
        </form>
      </div>
      <div class="smart-search-field">
        <div class="smart-search-title">Sites</div>
        <form class="google-search-bar smart-search-bar" data-smart-search target="_blank" rel="noopener noreferrer">
          <div class="smart-search-picker">
            <button type="button" class="smart-search-toggle" aria-haspopup="listbox" aria-expanded="false">
              <img src="/images/wikipedia-globe.svg" alt="" class="smart-search-icon">
              <span class="smart-search-label">Wikipedia</span>
              <svg class="icon-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="0.65em" height="0.65em" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="smart-search-menu" role="listbox">
              <button type="button" role="option" class="smart-search-option active" data-label="Wikipedia" data-icon="/images/wikipedia-globe.svg" data-placeholder="Search Wikipedia..." data-url="https://en.wikipedia.org/wiki/Special:Search?search={query}"><img src="/images/wikipedia-globe.svg" alt="">Wikipedia</button>
              <button type="button" role="option" class="smart-search-option" data-label="Scholar" data-icon="/images/google-scholar-icon.svg" data-placeholder="Search Scholar..." data-url="https://scholar.google.com/scholar?q={query}"><img src="/images/google-scholar-icon.svg" alt="">Scholar</button>
              <button type="button" role="option" class="smart-search-option" data-label="IXL" data-icon="/images/ixl-square.png" data-placeholder="Search IXL..." data-url="https://www.ixl.com/search?q={query}"><img src="/images/ixl-square.png" alt="">IXL</button>
              <button type="button" role="option" class="smart-search-option" data-label="YouTube" data-icon="/images/youtube-full.png" data-placeholder="Search YouTube..." data-url="https://www.youtube.com/results?search_query={query}"><img src="/images/youtube-full.png" alt="">YouTube</button>
            </div>
          </div>
          <span class="smart-search-separator" aria-hidden="true">|</span>
          <input type="text" name="q" placeholder="Search Wikipedia..." class="google-search-input smart-search-input">
          <button type="button" class="google-search-clear" onclick="this.previousElementSibling.value='';this.previousElementSibling.focus()"><img src="/images/x.svg" alt="Clear"></button>
          <button type="submit" class="google-search-btn"><img src="/images/search.png" alt="Search"></button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/smart-search';
</script>
