---
import { Button, Card, IconButton, SearchField } from './ui';
import { iconChevronDown, iconSearch, iconTimes } from '../scripts/icons';
interface SearchOption {
  label: string;
  icon: string;
  placeholder: string;
  url: string;
}

const searchGroups: { label: string; options: SearchOption[] }[] = [
  {
    label: 'Google',
    options: [
      { label: 'Web', icon: '/images/new-google.svg', placeholder: 'Search the web…', url: 'https://www.google.com/search?udm=web&q={query}' },
      { label: 'Image', icon: '/images/google-lens.svg', placeholder: 'Search images…', url: 'https://www.google.com/search?udm=2&q={query}' },
      { label: 'Videos', icon: '/images/google-video-search.svg', placeholder: 'Search videos…', url: 'https://www.google.com/search?tbm=vid&q={query}' },
      { label: 'Books', icon: '/images/google-books-search.svg', placeholder: 'Search books…', url: 'https://www.google.com/search?tbm=bks&q={query}' },
      { label: 'News', icon: '/images/google-news.svg', placeholder: 'Search news…', url: 'https://www.google.com/search?tbm=nws&q={query}' },
      { label: 'Maps', icon: '/images/new-google-maps.svg', placeholder: 'Search Maps…', url: 'https://www.google.com/maps/search/{query}' },
    ],
  },
  {
    label: 'G-Suite',
    options: [
      { label: 'Drive', icon: '/images/new-google-drive.svg', placeholder: 'Search Drive…', url: 'https://drive.google.com/drive/u/0/search?q={query}' },
      { label: 'Docs', icon: '/images/new-google-docs.svg', placeholder: 'Search Docs…', url: 'https://docs.google.com/document/u/0/?tgif=d&q={query}' },
      { label: 'Slides', icon: '/images/new-google-slides.svg', placeholder: 'Search Slides…', url: 'https://docs.google.com/presentation/u/0/?tgif=d&q={query}' },
      { label: 'Sheets', icon: '/images/new-google-sheets.svg', placeholder: 'Search Sheets…', url: 'https://docs.google.com/spreadsheets/u/0/?tgif=d&q={query}' },
      { label: 'Gmail', icon: '/images/new-gmail.svg', placeholder: 'Search Gmail…', url: 'https://mail.google.com/mail/u/0/#search/{query}' },
      { label: 'Calendar', icon: '/images/new-google-calendar.svg', placeholder: 'Search Calendar…', url: 'https://calendar.google.com/calendar/u/0/r/search?q={query}' },
    ],
  },
  {
    label: 'Sites',
    options: [
      { label: 'Wikipedia', icon: '/images/wikipedia-globe.svg', placeholder: 'Search Wikipedia…', url: 'https://en.wikipedia.org/wiki/Special:Search?search={query}' },
      { label: 'Scholar', icon: '/images/google-scholar-icon.svg', placeholder: 'Search Scholar…', url: 'https://scholar.google.com/scholar?q={query}' },
      { label: 'IXL', icon: '/images/ixl-square.png', placeholder: 'Search IXL…', url: 'https://www.ixl.com/search?q={query}' },
      { label: 'YouTube', icon: '/images/youtube-full.png', placeholder: 'Search YouTube…', url: 'https://www.youtube.com/results?search_query={query}' },
    ],
  },
];

const defaultOption = searchGroups[0].options[0];
---

<section class="google-search-row home-unified-search-row">
  <div class="container">
    <form class="google-search-bar smart-search-bar smart-search-unified" data-smart-search>
      <div class="smart-search-picker">
        <Button type="button" variant="ghost" size="small" class="smart-search-toggle" aria-haspopup="listbox" aria-expanded="false" aria-label="Choose a search destination">
          <img src={defaultOption.icon} alt="" class="smart-search-icon" />
          <span class="smart-search-label">{defaultOption.label}</span>
          <span class="smart-search-chevron" set:html={iconChevronDown}></span>
        </Button>
        <Card class="smart-search-menu" role="listbox" aria-label="Search destinations">
          <div class="smart-search-menu-columns">
            {searchGroups.map((group, groupIndex) => (
              <div class="smart-search-menu-group" role="group" aria-labelledby={`home-search-group-${groupIndex}`}>
                <p id={`home-search-group-${groupIndex}`}>{group.label}</p>
                {group.options.map((option, optionIndex) => (
                  <Button
                    type="button"
                    variant="ghost"
                    size="small"
                    role="option"
                    class:list={['smart-search-option', groupIndex === 0 && optionIndex === 0 && 'active']}
                    aria-selected={groupIndex === 0 && optionIndex === 0 ? 'true' : 'false'}
                    data-label={option.label}
                    data-icon={option.icon}
                    data-placeholder={option.placeholder}
                    data-url={option.url}
                  >
                    <img src={option.icon} alt="" />
                    <span>{option.label}</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
                  </Button>
                ))}
              </div>
            ))}
          </div>
        </Card>
      </div>
      <span class="smart-search-separator" aria-hidden="true"></span>
      <SearchField label="Search the selected destination" icon="" name="q" placeholder={defaultOption.placeholder} class="smart-search-field" inputClass="google-search-input smart-search-input" autocomplete="off" />
      <IconButton icon={iconTimes} label="Clear search" size="small" class="google-search-clear smart-search-clear" data-smart-search-clear />
      <IconButton icon={iconSearch} label="Search selected destination" size="small" type="submit" class="google-search-btn smart-search-submit" />
    </form>
  </div>
</section>

<script>
  import '../scripts/smart-search';
</script>
