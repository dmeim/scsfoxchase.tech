---
import { Card } from './ui';
import { displayImage } from '../lib/display-images';
---
<section class="newhome-groups">
  <div class="container">
    <div class="home-launcher-grid">
      <Card role="group" class="newhome-group-card home-launcher-column home-launcher-left" aria-label="Learning apps">
        <a href="https://portal.follettdestiny.com/portal?appId=destiny-RZXK-3JKZ&siteGuid=0B91A465-AC66-4839-A810-FBE8955C907E&app=Destiny%20Discover" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src={displayImage("/images/scs-destiny-logo.png")} alt="Destiny">Destiny</a>
        <a href="https://www.ixl.com/signin/saintcecilia" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src={displayImage("/images/ixl-square.png")} alt="IXL">IXL</a>
        <a href="https://www.tinkercad.com/login" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src="/images/tinkercad-icon.svg" alt="TinkerCAD">TinkerCAD</a>
        <a href="https://play.sumdog.com/sch/stcecilia8" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src={displayImage("/images/sumdog-square.png")} alt="Sumdog">Sumdog</a>
      </Card>
      <Card role="group" class="newhome-group-card home-launcher-suite" aria-label="G-Suite">
        <div class="newhome-group-links newhome-group-links-rows">
          <div class="newhome-link-row newhome-link-row-2">
            <a href="https://accounts.google.com/ServiceLogin?continue=https%3A%2F%2Fclassroom.google.com&passive=true" target="_blank" rel="noopener noreferrer" class="mockup-link newhome-feature-link"><img src={displayImage("/images/google-classroom-logo-clean.png")} alt="Google Classroom">Classroom</a>
            <a href="https://drive.google.com" target="_blank" rel="noopener noreferrer" class="mockup-link newhome-feature-link"><img src="/images/new-google-drive.svg" alt="Google Drive">Drive</a>
          </div>
          <div class="newhome-link-row">
            <a href="https://docs.google.com" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src="/images/new-google-docs.svg" alt="Google Docs">Docs</a>
            <a href="https://sheets.google.com" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src="/images/new-google-sheets.svg" alt="Google Sheets">Sheets</a>
            <a href="https://slides.google.com" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src="/images/new-google-slides.svg" alt="Google Slides">Slides</a>
          </div>
          <div class="newhome-link-row">
            <a href="https://calendar.google.com" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src="/images/new-google-calendar.svg" alt="Google Calendar">Calendar</a>
            <a href="https://mail.google.com" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src="/images/new-gmail.svg" alt="Gmail">Gmail</a>
            <a href="https://meet.google.com" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src="/images/new-google-meet.svg" alt="Google Meet">Meet</a>
          </div>
          <div class="newhome-link-row">
            <a href="https://tasks.google.com/" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src="/images/new-google-tasks.svg" alt="Google Tasks">Tasks</a>
            <a href="https://docs.google.com/videos/u/0/" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src="/images/new-google-vids.svg" alt="Google Vids">Vids</a>
            <a href="https://keep.google.com/" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src="/images/new-google-keep.svg" alt="Google Keep">Keep</a>
          </div>
        </div>
      </Card>
      <Card role="group" class="newhome-group-card home-launcher-column home-launcher-right" aria-label="Creative and typing apps">
        <a href="https://www.canva.com/login/" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src={displayImage("/images/canva-square.png")} alt="Canva">Canva</a>
        <a href="https://typesetgo.app" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src={displayImage("/images/typesetgo.png")} alt="TypeSetGo">TypeSetGo</a>
        <a href="https://www.typing.com/student/lessons" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src={displayImage("/images/typing-com-logo.png")} alt="Typing.com">Typing.com</a>
        <a href="https://monkeytype.com?testSettings=NoIgLglgtgpiA0IAMCB2BXANp+AzAhpgM4x6EmIyoDmmERAFgiKgPYBOUhaWmAukA" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src={displayImage("/images/monkeytype-logo.png")} alt="Monkeytype">Monkeytype</a>
      </Card>
      {/* Temporarily hidden; keep these links for future use.
      <Card class="newhome-group-card home-launcher-extras">
        <h2 class="app-row-header">Sites</h2>
        <div class="newhome-link-row newhome-link-row-2">
          <a href="https://sso.prodigygame.com/game/login" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src="/images/prodigy-math-icon.svg" alt="Prodigy">Prodigy</a>
          <a href="https://www.hellosmart.com/link/" target="_blank" rel="noopener noreferrer" class="mockup-link"><img src={displayImage("/images/lumio-logo.png")} alt="Lumio">Lumio</a>
        </div>
      </Card>
      */}
    </div>
  </div>
</section>
