---
import { getCollection } from 'astro:content';
import trending from '../data/trending.json';
import { ChipGroup, IconButton, ProgressTabs, SearchField } from './ui';
import { iconChevronLeft, iconChevronRight } from '../scripts/icons';

const games = (await getCollection('games')).map((entry) => entry.data);
const trendingIds = trending as string[];
const catalogPayload = JSON.stringify({ games, trendingIds });
const trendingGames = trendingIds
  .map((id) => games.find((game) => game.id === id))
  .filter((game): game is (typeof games)[number] => Boolean(game));
const gradeOptions = Array.from({ length: 8 }, (_, index) => ({ label: String(index + 1), value: String(index + 1) }));
const primaryCategories = [...new Set(games.flatMap((game) => game.primaryCategories || []))]
  .sort()
  .map((value) => ({ label: value, value }));
const secondaryCategories = [...new Set(games.flatMap((game) => game.secondaryCategories || game.categories || []))]
  .sort()
  .map((value) => ({ label: value, value }));
---

<section class="hero-carousel">
  <div class="carousel-container">
    <IconButton icon={iconChevronLeft} label="Previous slide" class="carousel-button prev" />
    <div class="carousel-track-container">
      <ul class="carousel-track" id="trending-carousel">
        <li class="carousel-slide loading">
          <div class="loading-spinner"></div>
          <p>Loading trending games...</p>
        </li>
      </ul>
    </div>
    <IconButton icon={iconChevronRight} label="Next slide" class="carousel-button next" />
    <ProgressTabs
      options={trendingGames.map((game) => ({ label: `Show ${game.name}`, value: game.id }))}
      selected={trendingGames[0]?.id}
      ariaLabel="Trending slides"
      class="carousel-nav"
      tabClass="carousel-indicator"
    />
  </div>
</section>

<section class="games-section">
  <div class="container">
    <div class="filter-container">
      <div class="search-grade-row">
        <SearchField type="text" id="game-search" label="Search games" placeholder={`Search All ${games.length} Games...`} class="search-bar" autocomplete="off" />
        <div class="filter-group filter-group-inline">
          <span class="filter-group-label">Grade</span>
          <ChipGroup id="grade-chips" class="filter-chips-row" chipClass="filter-chip" options={gradeOptions} selected={[]} multiple ariaLabel="Filter by grade" />
        </div>
      </div>
      <div class="filter-group">
        <span class="filter-group-label">Type</span>
        <ChipGroup id="primary-category-chips" class="filter-chips-row" chipClass="filter-chip" options={primaryCategories} selected={[]} multiple ariaLabel="Filter by type" />
      </div>
      <div class="filter-group">
        <span class="filter-group-label">Genre</span>
        <ChipGroup id="secondary-category-chips" class="filter-chips-row" chipClass="filter-chip" options={secondaryCategories} selected={[]} multiple ariaLabel="Filter by genre" />
      </div>
    </div>

    <div class="games-grid" id="games-grid">
      <div class="loading-container">
        <div class="loading-spinner"></div>
        <p>Loading games...</p>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="games-catalog-data" set:html={catalogPayload} />

<script>
  import { initGamesCatalog } from '../scripts/games-catalog';

  const dataEl = document.getElementById('games-catalog-data');
  if (dataEl?.textContent) {
    const { games, trendingIds } = JSON.parse(dataEl.textContent) as {
      games: Parameters<typeof initGamesCatalog>[0];
      trendingIds: string[];
    };
    initGamesCatalog(games, trendingIds);
  }
</script>
