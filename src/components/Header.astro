---
import ClerkAuth from './ClerkAuth';
import TempNotificationMenu from './TempNotificationMenu.astro';
import NotificationCenter from './NotificationCenter.astro';
import {
  iconHouse,
  iconGamepad2,
  iconMessageCircleQuestion,
  iconLayoutFreeform,
  iconMaximize2,
  iconMinimize2,
  iconPencil,
  iconClipboard,
  iconInfo,
  iconLogIn,
} from '../scripts/icons';

interface Props {
  boardChrome?: boolean;
}

const { boardChrome = false } = Astro.props;
const pathname = Astro.url.pathname;
const notificationDemo = pathname === '/temp';
const homeActive = pathname === '/' || pathname === '';
const gamesActive = pathname === '/games' || pathname.startsWith('/games/');
const helpActive =
  pathname === '/help' ||
  pathname === '/forms' ||
  pathname.startsWith('/forms/') ||
  pathname === '/guides' ||
  pathname.startsWith('/guides/') ||
  pathname.startsWith('/form/') ||
  pathname.startsWith('/guide/');
---
<header>
  <div class="container">
    <div class="header-left">
      <a href="/" class="header-brand" aria-label="St. Cecilia Technology home">
        <img src="/images/scs-logo.png" alt="SCS Logo" class="header-logo" width="32" height="32">
        <h1>St. Cecilia Technology</h1>
      </a>
      <div id="theme-toggle-host" class="theme-toggle-host"></div>
      <button
        type="button"
        id="header-fullscreen-btn"
        class="header-fullscreen-btn"
        aria-label="Enter full screen"
        title="Enter full screen"
        hidden
      >
        <span class="header-chip-icon header-fullscreen-icon-enter" set:html={iconMaximize2} />
        <span class="header-chip-icon header-fullscreen-icon-exit" set:html={iconMinimize2} />
      </button>
    </div>

    <div
      class="header-center"
      data-whiteboard-menu
      data-whiteboard-mode={boardChrome ? 'manage' : 'hub'}
    >
      {boardChrome ? (
        <>
          <button
            type="button"
            class="whiteboard-toggle"
            data-whiteboard-toggle
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="whiteboard-menu-panel"
            id="whiteboard-menu-toggle"
          >
            <span class="header-chip-icon" set:html={iconLayoutFreeform} />
            Whiteboard
          </button>
          <div
            class="whiteboard-menu whiteboard-menu--manage"
            id="whiteboard-menu-panel"
            data-whiteboard-panel
            role="dialog"
            aria-label="Manage whiteboard"
            aria-hidden="true"
          >
            <div class="whiteboard-manage-layout" data-wb-manage-layout>
              <div class="whiteboard-manage-primary">
                <div class="whiteboard-manage-header">
                  <a href="/whiteboard" class="whiteboard-manage-library">← Library</a>
                  <div class="whiteboard-manage-name-wrap">
                    <p class="whiteboard-manage-title-ro" data-wb-live-title hidden></p>
                    <div class="whiteboard-manage-name-edit" data-wb-manage-name-wrap hidden>
                      <button
                        type="button"
                        class="whiteboard-manage-title-btn"
                        data-wb-title-display
                      >
                        <span data-wb-title-text></span>
                        <span class="whiteboard-manage-pencil" set:html={iconPencil} />
                      </button>
                      <form class="whiteboard-manage-name" data-wb-manage-name hidden>
                        <label class="visually-hidden" for="wb-manage-title">Board name</label>
                        <input
                          id="wb-manage-title"
                          class="whiteboard-join-input"
                          type="text"
                          name="title"
                          data-wb-manage-title
                          placeholder="Name this whiteboard"
                          autocomplete="off"
                          spellcheck="false"
                          maxlength="80"
                        />
                      </form>
                      <p class="whiteboard-join-hint" data-wb-manage-hint hidden></p>
                    </div>
                  </div>
                </div>

                <div class="whiteboard-manage-col whiteboard-manage-col--people" data-wb-manage-people>
                  <ul class="whiteboard-people-list" data-wb-people-list aria-label="People" hidden></ul>
                  <p class="whiteboard-join-hint whiteboard-people-empty" data-wb-people-empty>
                    People appear when sync is on.
                  </p>
                  <p class="whiteboard-join-hint" data-wb-people-hint hidden></p>
                </div>
              </div>

              <div class="whiteboard-manage-sharing">
                <div class="whiteboard-manage-code-block" data-wb-manage-share hidden>
                  <p class="whiteboard-join-label">Share Code</p>
                  <button
                    type="button"
                    class="whiteboard-join-input whiteboard-join-input--code whiteboard-share-code"
                    aria-label="Share code — click to copy"
                    data-wb-share-code
                    disabled
                  >
                    <span class="whiteboard-share-code-value" data-wb-share-code-value>Code</span>
                  </button>
                  <div class="whiteboard-share-copies">
                    <div class="whiteboard-share-action">
                      <button
                        type="button"
                        class="whiteboard-share-copy-btn"
                        data-wb-share-copy-code
                      >
                        <span class="whiteboard-share-copy-icon" set:html={iconClipboard} />
                        Copy Code
                      </button>
                      <button
                        type="button"
                        class="whiteboard-info-btn"
                        data-wb-info="copy-code"
                        aria-expanded="false"
                        aria-controls="wb-info-copy-code"
                        aria-label="About Copy Code"
                      >
                        <span set:html={iconInfo} />
                      </button>
                      <p
                        class="whiteboard-info-pop"
                        id="wb-info-copy-code"
                        data-wb-info-pop="copy-code"
                        hidden
                      >
                        Copies the join code. Anyone with it can open this board.
                      </p>
                    </div>
                    <div class="whiteboard-share-action">
                      <button
                        type="button"
                        class="whiteboard-share-copy-btn"
                        data-wb-share-copy-link
                      >
                        <span class="whiteboard-share-copy-icon" set:html={iconClipboard} />
                        Copy Link
                      </button>
                      <button
                        type="button"
                        class="whiteboard-info-btn"
                        data-wb-info="copy-link"
                        aria-expanded="false"
                        aria-controls="wb-info-copy-link"
                        aria-label="About Copy Link"
                      >
                        <span set:html={iconInfo} />
                      </button>
                      <p
                        class="whiteboard-info-pop"
                        id="wb-info-copy-link"
                        data-wb-info-pop="copy-link"
                        hidden
                      >
                        Copies the permanent board link. View-only unless you set Editor on People.
                      </p>
                    </div>
                  </div>
                  <p
                    class="whiteboard-share-toast"
                    data-wb-share-toast
                    role="status"
                    aria-live="polite"
                    hidden
                  ></p>
                  <p class="whiteboard-join-hint" data-wb-share-hint hidden></p>
                </div>

              <div
                class="whiteboard-manage-col whiteboard-manage-col--features"
                data-wb-manage-features
                hidden
              >
                <p class="whiteboard-join-label">Sharing Features</p>
                <div class="whiteboard-feature-row" data-wb-class-can-edit>
                  <label class="whiteboard-switch">
                    <span class="whiteboard-switch-label">Group Edit</span>
                    <span class="whiteboard-switch-label" data-wb-class-can-edit-state>Off</span>
                    <input
                      type="checkbox"
                      aria-label="Group Edit — Editors can draw when on"
                      data-wb-class-can-edit-toggle
                    />
                    <span class="whiteboard-switch-track" aria-hidden="true"></span>
                  </label>
                  <button
                    type="button"
                    class="whiteboard-info-btn"
                    data-wb-info="group-edit"
                    aria-expanded="false"
                    aria-controls="wb-info-group-edit"
                    aria-label="About Group Edit"
                  >
                    <span set:html={iconInfo} />
                  </button>
                  <p
                    class="whiteboard-info-pop"
                    id="wb-info-group-edit"
                    data-wb-info-pop="group-edit"
                    hidden
                  >
                    When on, Editors can draw. When off, only Owner and Manager can draw.
                  </p>
                </div>
                <div class="whiteboard-feature-row" data-wb-manage-force-follow hidden>
                  <label class="whiteboard-switch">
                    <span class="whiteboard-switch-label">Follow User</span>
                    <span class="whiteboard-switch-label" data-wb-force-follow-state>Off</span>
                    <input
                      type="checkbox"
                      aria-label="Lock everyone to follow a screen"
                      data-wb-force-follow-toggle
                    />
                    <span class="whiteboard-switch-track" aria-hidden="true"></span>
                  </label>
                  <button
                    type="button"
                    class="whiteboard-info-btn"
                    data-wb-info="follow-user"
                    aria-expanded="false"
                    aria-controls="wb-info-follow-user"
                    aria-label="About Follow User"
                  >
                    <span set:html={iconInfo} />
                  </button>
                  <p
                    class="whiteboard-info-pop"
                    id="wb-info-follow-user"
                    data-wb-info-pop="follow-user"
                    hidden
                  >
                    Locks everyone’s view to the person in the menu. They cannot pan away until you turn it off.
                  </p>
                  <label class="whiteboard-people-target">
                    <span class="visually-hidden">Who others follow</span>
                    <select
                      class="whiteboard-people-target-select"
                      aria-label="Who others follow"
                      data-wb-force-follow-target
                    >
                      <option value="">Me</option>
                    </select>
                  </label>
                  <p class="whiteboard-join-hint" data-wb-force-follow-hint hidden></p>
                </div>
              </div>
              </div>
            </div>
          </div>
        </>
      ) : (
        <a
          href="/whiteboard"
          class="whiteboard-toggle"
          data-whiteboard-hub-link
        >
          <span class="header-chip-icon" set:html={iconLayoutFreeform} />
          Whiteboard
        </a>
      )}
    </div>

    <div class:list={['header-right', notificationDemo && 'header-right--notification-demo']}>
      <nav aria-label="Primary">
        <ul>
          <li>
            <a href="/" class:list={[{ active: homeActive }]}>
              <span class="header-chip-icon" set:html={iconHouse} />
              Home
            </a>
          </li>
          <li>
            <a href="/games" class:list={[{ active: gamesActive }]}>
              <span class="header-chip-icon" set:html={iconGamepad2} />
              Games
            </a>
          </li>
          <li>
            <a href="/help" class:list={[{ active: helpActive }]}>
              <span class="header-chip-icon" set:html={iconMessageCircleQuestion} />
              Help
            </a>
          </li>
          <li>
            {notificationDemo ? <TempNotificationMenu /> : <NotificationCenter />}
          </li>
          <li class="header-auth-item">
            {notificationDemo ? (
              <span class="header-auth-btn temp-demo-auth-chip" aria-label="Sign in preview">
                <span class="header-chip-icon" set:html={iconLogIn} />
                Sign in
              </span>
            ) : (
              <ClerkAuth client:only="react">
                <div class="header-auth" slot="fallback" aria-hidden="true"></div>
              </ClerkAuth>
            )}
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>
