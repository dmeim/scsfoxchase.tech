---
import ClerkAuth from './ClerkAuth';

interface Props {
  boardChrome?: boolean;
}

const { boardChrome = false } = Astro.props;
const pathname = Astro.url.pathname;
const homeActive = pathname === '/' || pathname === '';
const gamesActive = pathname === '/games' || pathname.startsWith('/games/');
const formsActive = pathname === '/forms' || pathname.startsWith('/forms/');
// Avoid a second ClerkProvider island next to SsoCallback on the OAuth return page.
const hideAuth = pathname.startsWith('/sso-callback');
---
<header>
  <div class="container">
    <div class="header-left">
      <a href="/" class="header-brand" aria-label="St. Cecilia Technology home">
        <img src="/images/scs-logo.png" alt="SCS Logo" class="header-logo" width="32" height="32">
        <h1>St. Cecilia Technology</h1>
      </a>
      <div id="theme-toggle-host" class="theme-toggle-host"></div>
    </div>

    <div class="header-center" data-whiteboard-menu data-whiteboard-mode={boardChrome ? 'manage' : 'hub'}>
      {boardChrome ? (
        <>
          <button
            type="button"
            class="whiteboard-toggle"
            data-whiteboard-toggle
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="whiteboard-menu-panel"
            id="whiteboard-menu-toggle"
          >
            Whiteboard
          </button>
          <div
            class="whiteboard-menu whiteboard-menu--manage"
            id="whiteboard-menu-panel"
            data-whiteboard-panel
            role="dialog"
            aria-label="Manage whiteboard"
            aria-hidden="true"
          >
            <form class="whiteboard-manage-name" data-wb-manage-name>
              <label class="whiteboard-join-label" for="wb-manage-title">Name this whiteboard</label>
              <div class="whiteboard-join-row">
                <input
                  id="wb-manage-title"
                  class="whiteboard-join-input"
                  type="text"
                  name="title"
                  data-wb-manage-title
                  placeholder="Name this whiteboard"
                  autocomplete="off"
                  spellcheck="false"
                  maxlength="80"
                />
                <button type="submit" class="whiteboard-join-btn" data-wb-manage-save>Save</button>
              </div>
              <p class="whiteboard-join-hint" data-wb-manage-hint hidden></p>
            </form>

            <div class="whiteboard-menu-divider" role="separator"></div>

            <div class="whiteboard-manage-block" data-wb-manage-share>
              <div class="whiteboard-manage-share-head">
                <p class="whiteboard-join-label">Share code</p>
                <label class="whiteboard-switch whiteboard-switch--stub" title="Coming soon">
                  <span class="whiteboard-switch-label" data-wb-share-state>Closed</span>
                  <input
                    type="checkbox"
                    disabled
                    aria-disabled="true"
                    aria-label="Open or close share code (coming soon)"
                    data-wb-share-toggle
                  />
                  <span class="whiteboard-switch-track" aria-hidden="true"></span>
                </label>
              </div>
              <div class="whiteboard-join-row">
                <input
                  class="whiteboard-join-input whiteboard-join-input--code"
                  type="text"
                  value=""
                  placeholder="Coming soon"
                  disabled
                  aria-disabled="true"
                  data-wb-share-code
                />
                <button type="button" class="whiteboard-join-btn" disabled data-wb-share-copy>
                  Copy
                </button>
              </div>
              <p class="whiteboard-join-hint">
                Join codes arrive with multiplayer. When live, codes expire after 12 hours —
                bookmark the board page to come back later.
              </p>
            </div>

            <div class="whiteboard-menu-divider" role="separator"></div>

            <div class="whiteboard-manage-block" data-wb-manage-people>
              <p class="whiteboard-join-label">People</p>
              <div class="whiteboard-people-head" aria-hidden="true">
                <span>Name</span>
                <span>Edit</span>
              </div>
              <p class="whiteboard-join-hint whiteboard-people-empty" data-wb-people-empty>
                People appear when sync is on.
              </p>
            </div>

            <div class="whiteboard-menu-divider" role="separator"></div>

            <a href="/whiteboard" class="whiteboard-menu-action whiteboard-menu-action--secondary">
              Whiteboard library
            </a>
          </div>
        </>
      ) : (
        <a
          href="/whiteboard"
          class="whiteboard-toggle"
          data-whiteboard-hub-link
        >
          Whiteboard
        </a>
      )}
    </div>

    <div class="header-right">
      <nav>
        <ul>
          <li><a href="/" class:list={[{ active: homeActive }]}>Home</a></li>
          <li><a href="/games" class:list={[{ active: gamesActive }]}>Games</a></li>
          <li><a href="/forms" class:list={[{ active: formsActive }]}>Forms</a></li>
        </ul>
      </nav>
      {!hideAuth && <ClerkAuth client:load />}
    </div>
  </div>
</header>
