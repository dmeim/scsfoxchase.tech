---
import ClerkAuth from './ClerkAuth';
import TempNotificationMenu from './TempNotificationMenu.astro';
import NotificationCenter from './NotificationCenter.astro';
import {
  Button,
  Card,
  Feedback,
  SegmentedControl,
  SelectField,
  TextField,
  Toggle,
} from './ui';
import {
  iconArrowLeft,
  iconHouse,
  iconGamepad2,
  iconMessageCircleQuestion,
  iconLayoutFreeform,
  iconMaximize2,
  iconMinimize2,
  iconPencil,
  iconClipboard,
  iconLogIn,
  iconMoon,
  iconSun,
  iconSunMoon,
} from '../scripts/icons';

interface Props {
  boardChrome?: boolean;
}

const { boardChrome = false } = Astro.props;
const pathname = Astro.url.pathname;
const notificationDemo = pathname === '/temp';
---
<header>
  <div class="container">
    <div class="header-left">
      <a href="/" class="header-brand" aria-label="St. Cecilia Technology home">
        <img src="/images/scs-logo.png" alt="SCS Logo" class="header-logo" width="32" height="32">
        <h1>St. Cecilia Technology</h1>
      </a>
      <SegmentedControl
        id="theme-toggle"
        class="theme-toggle"
        optionClass="theme-toggle-option"
        ariaLabel="Color theme"
        selected="system"
        options={[
          { label: 'Light', value: 'light', icon: iconSun },
          { label: 'System', value: 'system', icon: iconSunMoon },
          { label: 'Dark', value: 'dark', icon: iconMoon },
        ]}
      />
      <Button
        type="button"
        id="header-fullscreen-btn"
        variant="glass"
        size="small"
        class="header-fullscreen-btn"
        aria-label="Enter full screen"
        title="Enter full screen"
        hidden
      >
        <span class="header-chip-icon header-fullscreen-icon-enter" set:html={iconMaximize2} />
        <span class="header-chip-icon header-fullscreen-icon-exit" set:html={iconMinimize2} />
      </Button>
    </div>

    <div
      class="header-center"
      data-whiteboard-menu
      data-whiteboard-mode={boardChrome ? 'manage' : 'hub'}
    >
      {boardChrome ? (
        <>
          <Button
            type="button"
            variant="glass"
            size="small"
            class="whiteboard-toggle"
            data-whiteboard-toggle
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="whiteboard-menu-panel"
            id="whiteboard-menu-toggle"
            icon={iconLayoutFreeform}
          >Whiteboard</Button>
          <Card
            class="whiteboard-menu whiteboard-menu--manage"
            id="whiteboard-menu-panel"
            data-whiteboard-panel
            role="dialog"
            aria-label="Manage whiteboard"
            aria-hidden="true"
          >
            <div class="whiteboard-manage-header">
              <Button
                href="/whiteboard"
                variant="ghost"
                size="small"
                class="whiteboard-manage-library"
                icon={iconArrowLeft}
              >
                <span class="whiteboard-manage-library-icon" set:html={iconLayoutFreeform} />
                <span>Library</span>
              </Button>
              <div class="whiteboard-manage-name-wrap">
                <p class="whiteboard-manage-title-ro" data-wb-live-title hidden></p>
                <div class="whiteboard-manage-name-edit" data-wb-manage-name-wrap hidden>
                  <Button
                    type="button"
                    variant="ghost"
                    size="small"
                    class="whiteboard-manage-title-btn"
                    data-wb-title-display
                  >
                    <span data-wb-title-text></span>
                    <span class="whiteboard-manage-pencil" set:html={iconPencil} />
                  </Button>
                  <form class="whiteboard-manage-name" data-wb-manage-name hidden>
                    <TextField
                      label="Board name"
                      labelHidden
                      id="wb-manage-title"
                      class="whiteboard-manage-title-field"
                      inputClass="whiteboard-join-input"
                      name="title"
                      data-wb-manage-title
                      placeholder="Name this whiteboard"
                      autocomplete="off"
                      spellcheck="false"
                      maxlength="80"
                    />
                  </form>
                  <p class="whiteboard-join-hint" data-wb-manage-hint hidden></p>
                </div>
              </div>
              <span class="whiteboard-manage-header-spacer" aria-hidden="true"></span>
            </div>

            <div class="whiteboard-manage-layout" data-wb-manage-layout>
              <div class="whiteboard-manage-primary">
                <div class="whiteboard-manage-col whiteboard-manage-col--people" data-wb-manage-people>
                  <div class="whiteboard-people-heading">
                    <p class="whiteboard-join-label">People</p>
                    <span class="whiteboard-people-count" data-wb-people-count>0 connected</span>
                  </div>
                  <ul class="whiteboard-people-list" data-wb-people-list aria-label="People" hidden></ul>
                  <p class="whiteboard-join-hint whiteboard-people-empty" data-wb-people-empty>
                    People appear when sync is on.
                  </p>
                  <p class="whiteboard-join-hint" data-wb-people-hint hidden></p>
                </div>
              </div>

              <div class="whiteboard-manage-sharing">
                <div class="whiteboard-manage-code-block" data-wb-manage-share hidden>
                  <div class="whiteboard-manage-share-head">
                    <p class="whiteboard-join-label">Share Code</p>
                    <Button
                      type="button"
                      variant="outline"
                      class="whiteboard-join-input whiteboard-join-input--code whiteboard-share-code"
                      aria-label="Share code — click to copy"
                      data-wb-share-code
                      disabled
                    >
                      <span class="whiteboard-share-code-value" data-wb-share-code-value>Code</span>
                    </Button>
                  </div>
                  <div class="whiteboard-share-copies">
                    <Button
                      type="button"
                      variant="primary"
                      size="small"
                      class="whiteboard-share-copy-btn"
                      data-wb-share-copy-code
                      icon={iconClipboard}
                      disabled
                    >
                      Copy Share Code
                    </Button>
                    <Button
                      type="button"
                      variant="outline"
                      size="small"
                      class="whiteboard-share-copy-btn"
                      data-wb-share-copy-link
                      icon={iconClipboard}
                    >
                      Copy Board Link
                    </Button>
                  </div>
                  <Feedback
                    tone="success"
                    class="whiteboard-share-toast"
                    data-wb-share-toast
                    role="status"
                    aria-live="polite"
                    hidden
                  />
                  <p class="whiteboard-join-hint" data-wb-share-hint hidden></p>
                </div>

                <div
                  class="whiteboard-manage-col whiteboard-manage-col--features"
                  data-wb-manage-features
                  hidden
                >
                  <div class="whiteboard-feature-row" data-wb-class-can-edit>
                    <Toggle
                      class="whiteboard-switch"
                      label="Group Edit"
                      description="Let editors draw on this board"
                      aria-label="Group Edit — Editors can draw when on"
                      data-wb-class-can-edit-toggle
                    >
                      <span slot="state" class="whiteboard-switch-label" data-wb-class-can-edit-state>Off</span>
                    </Toggle>
                  </div>
                  <div class="whiteboard-feature-row" data-wb-manage-force-follow hidden>
                    <Toggle
                      class="whiteboard-switch"
                      label="Follow User"
                      description="Keep guests on one person’s view"
                      aria-label="Lock everyone to follow a screen"
                      data-wb-force-follow-toggle
                    >
                      <span slot="state" class="whiteboard-switch-label" data-wb-force-follow-state>Off</span>
                    </Toggle>
                    <SelectField
                      label="Person to follow"
                      class="whiteboard-people-target"
                      selectClass="whiteboard-people-target-select"
                      options={[{ label: 'Me', value: '' }]}
                      data-wb-force-follow-target
                    />
                    <p class="whiteboard-join-hint" data-wb-force-follow-hint hidden></p>
                  </div>
                </div>
              </div>
            </div>
          </Card>
        </>
      ) : (
        <Button
          href="/whiteboard"
          variant="glass"
          size="small"
          class="whiteboard-toggle"
          data-whiteboard-hub-link
          icon={iconLayoutFreeform}
        >
          Whiteboard
        </Button>
      )}
    </div>

    <div class:list={['header-right', notificationDemo && 'header-right--notification-demo']}>
      <nav aria-label="Primary">
        <ul>
          <li>
            <Button href="/" variant="ghost" size="small" icon={iconHouse}>Home</Button>
          </li>
          <li>
            <Button href="/games" variant="ghost" size="small" icon={iconGamepad2}>Games</Button>
          </li>
          <li>
            <Button href="/help" variant="ghost" size="small" icon={iconMessageCircleQuestion}>Help</Button>
          </li>
          <li>
            {notificationDemo ? <TempNotificationMenu /> : <NotificationCenter />}
          </li>
          <li class="header-auth-item">
            {notificationDemo ? (
              <Button variant="glass" size="small" class="header-auth-btn temp-demo-auth-chip" icon={iconLogIn} disabled aria-label="Sign in preview">Sign in</Button>
            ) : (
              <ClerkAuth client:only="react">
                <div class="header-auth" slot="fallback" aria-hidden="true"></div>
              </ClerkAuth>
            )}
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>
