---
import { iconGamepad2, iconWrench, iconKeyRound } from '../scripts/icons';

const forms = [
  {
    href: '/forms/game-request',
    label: 'Request A Game',
    icon: iconGamepad2,
  },
  {
    href: '/forms/help-tech',
    label: 'General Technology Help',
    icon: iconWrench,
  },
  {
    href: '/forms/help-account',
    label: 'Google/Account Help',
    icon: iconKeyRound,
  },
] as const;
---
<section class="forms-hub" aria-label="Technology forms">
  <div class="container form-shell">
    <div class="forms-grid">
      {
        forms.map((form) => (
          <a href={form.href} class="forms-tile">
            <span class="forms-tile-icon" set:html={form.icon} />
            <span class="forms-tile-label">{form.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
