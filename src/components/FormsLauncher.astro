---
import {
  iconGamepad2,
  iconWrench,
  iconKeyRound,
} from '../scripts/icons';
import { forms, formHref, type FormEntry } from '../data/forms';
import { ActionTile } from './ui';

interface Props {
  entries?: FormEntry[];
  ariaLabel?: string;
}

const { entries = forms, ariaLabel = 'Technology forms' } = Astro.props;

const icons = {
  iconGamepad2,
  iconWrench,
  iconKeyRound,
} as const;
---
<section class="forms-hub" aria-label={ariaLabel}>
  <div class="forms-grid">
    {
      entries.map((form) => (
        <ActionTile
          href={formHref(form.slug)}
          class="forms-tile"
          iconClass="forms-tile-icon"
          titleClass="forms-tile-label"
          icon={icons[form.icon]}
          title={form.label}
          description={form.status === 'stub' ? 'Coming soon' : undefined}
        />
      ))
    }
  </div>
</section>
