---
import {
  iconGamepad2,
  iconWrench,
  iconKeyRound,
} from '../scripts/icons';
import { forms, formHref, type FormEntry } from '../data/forms';

interface Props {
  entries?: FormEntry[];
  ariaLabel?: string;
}

const { entries = forms, ariaLabel = 'Technology forms' } = Astro.props;

const icons = {
  iconGamepad2,
  iconWrench,
  iconKeyRound,
} as const;
---
<section class="forms-hub" aria-label={ariaLabel}>
  <div class="forms-grid">
    {
      entries.map((form) => (
        <a href={formHref(form.slug)} class="forms-tile">
          <span class="forms-tile-icon" set:html={icons[form.icon]} />
          <span class="forms-tile-label">{form.label}</span>
        </a>
      ))
    }
  </div>
</section>
