---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { Button } from '../components/ui';
import { iconGamepad2, iconHouse } from '../scripts/icons';
---
<BaseLayout title="Page Not Found - St. Cecilia Technology">
  <meta
    slot="head"
    name="description"
    content="Page not found - St. Cecilia Technology"
  />

  <section class="error-container">
    <div class="error-icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="1em" height="1em" aria-hidden="true"><line x1="6" y1="12" x2="10" y2="12"/><line x1="8" y1="10" x2="8" y2="14"/><line x1="15" y1="13" x2="15.01" y2="13"/><line x1="18" y1="11" x2="18.01" y2="11"/><rect x="2" y="6" width="20" height="12" rx="2"/></svg>
    </div>
    <h2 class="error-title">Page Not Found</h2>
    <p class="error-message">
      Oops! The page you're looking for seems to have gone on an adventure of its own.
    </p>
    <div class="error-actions">
      <Button href="/" icon={iconHouse}>Go Home</Button>
      <Button href="/games" variant="outline" icon={iconGamepad2}>Explore Games</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .error-container {
    text-align: center;
    padding: 60px 20px;
    max-width: 600px;
    margin: 0 auto;
  }

  .error-icon {
    font-size: 80px;
    color: var(--primary-color);
    margin-bottom: 20px;
  }

  .error-icon svg {
    width: 1em;
    height: 1em;
  }

  .error-actions .ui-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .error-title {
    font-size: 2.5rem;
    margin-bottom: 20px;
    color: var(--primary-color);
  }

  .error-message {
    font-size: 1.2rem;
    margin-bottom: 30px;
    color: var(--text-color);
  }

  .error-actions {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .error-title {
      font-size: 2rem;
    }

    .error-message {
      font-size: 1rem;
    }
  }
</style>
