---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import SsoCallback from '../components/SsoCallback';
---

<BaseLayout title="Signing in — St. Cecilia Technology" hideFooter>
  <SsoCallback client:only="react" />
</BaseLayout>

<style is:global>
  .sso-callback {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40vh;
    padding: 2rem;
    font-size: 1rem;
    color: var(--text-color, #222);
  }
</style>
