---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Offline - St. Cecilia Technology">
  <meta
    slot="head"
    name="description"
    content="You are offline - St. Cecilia Technology"
  />

  <section class="offline-container">
    <div class="offline-icon">
      <i class="fas fa-wifi"></i>
    </div>
    <h2 class="offline-title">You're Offline</h2>
    <p class="offline-message">
      It looks like you don't have an internet connection right now. Some features may be
      limited until you're back online.
    </p>
    <div class="offline-actions">
      <button class="btn" id="refresh-btn" type="button">
        <i class="fas fa-sync-alt"></i> Try Again
      </button>
    </div>

    <div class="cached-content">
      <h3>Available Offline</h3>
      <p>You can still access these pages:</p>
      <div class="cached-links">
        <a href="/">Home Page</a>
        <a href="/games">Games Catalog</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .offline-container {
    text-align: center;
    padding: 60px 20px;
    max-width: 600px;
    margin: 0 auto;
  }

  .offline-icon {
    font-size: 80px;
    color: var(--primary-color);
    margin-bottom: 20px;
  }

  .offline-title {
    font-size: 2.5rem;
    margin-bottom: 20px;
    color: var(--primary-color);
  }

  .offline-message {
    font-size: 1.2rem;
    margin-bottom: 30px;
    color: var(--text-color);
  }

  .offline-actions {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .cached-content {
    background-color: var(--light-bg);
    border: 1px solid var(--border-color);
    border-radius: 2px;
    padding: 20px;
    margin-top: 40px;
  }

  :global([data-theme='dark']) .cached-content,
  :global([data-theme='system']) .cached-content {
    background-color: var(--dark-bg);
  }

  .cached-content h3 {
    margin-bottom: 15px;
    color: var(--primary-color);
  }

  .cached-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
  }

  @media (max-width: 480px) {
    .offline-title {
      font-size: 2rem;
    }

    .offline-message {
      font-size: 1rem;
    }
  }
</style>

<script>
  const refreshBtn = document.getElementById('refresh-btn');
  refreshBtn?.addEventListener('click', () => {
    window.location.reload();
  });

  window.addEventListener('online', () => {
    window.location.reload();
  });
</script>
