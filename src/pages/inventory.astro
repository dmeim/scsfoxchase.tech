---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { Button, Card, Dialog, Feedback, TextField } from '../components/ui';
import { iconPrint, iconQrCode, iconSearch } from '../scripts/icons';
import '../styles/inventory.css';
---
<BaseLayout title="Inventory Lookup | St. Cecilia Technology" bodyClass="asset-lookup-page">
  <meta
    slot="head"
    name="description"
    content="St. Cecilia Technology inventory lookup"
  />
  <meta slot="head" name="robots" content="noindex,nofollow" />

  <div class="asset-main">
    <section class="asset-lookup-section" aria-labelledby="asset-lookup-title">
      <div class="container asset-shell">
        <Card class="asset-lookup-panel">
          <div class="asset-title-row">
            <div>
              <h2 id="asset-lookup-title">Inventory Report</h2>
              <p class="asset-helper">Enter a device serial number or service tag to pull the matching record.</p>
              <p class="asset-helper">Scan, type, or paste a serial number like <code>ABC123XYZ</code>, or use a full inventory QR link.</p>
            </div>
          </div>

          <form id="assetLookupForm" class="asset-search-form" novalidate>
            <div class="asset-search-controls">
              <TextField
                label="Serial Number / Service Tag"
                labelHidden
                id="assetSerialInput"
                class="asset-serial-field"
                inputClass="asset-serial-input"
                name="serial"
                placeholder="Example: ABC123XYZ"
                autocomplete="off"
                autocapitalize="characters"
                spellcheck="false"
                required
              />
              <Button id="assetLookupButton" class="asset-lookup-button" type="submit" icon={iconSearch}>Lookup</Button>
              <Button id="assetScanButton" class="asset-scan-button" type="button" variant="secondary" icon={iconQrCode}>Scan QR</Button>
              <Button id="assetPrintButton" class="asset-print-button" type="button" variant="outline" icon={iconPrint} disabled>Print Report</Button>
            </div>
            <div class="asset-turnstile-row">
              <div
                id="assetTurnstile"
                class="asset-turnstile"
                data-action="inventory_lookup"
              ></div>
            </div>
          </form>

          <Feedback id="assetConfigNotice" tone="info" class="asset-config-notice" hidden />
        </Card>

        <Feedback id="assetMessage" class="asset-message" hidden />
        <div id="assetResult" class="asset-result" aria-live="polite" hidden></div>
      </div>
    </section>
  </div>

  <Dialog
    id="assetScannerModal"
    class="asset-scanner-modal asset-scanner-dialog"
    headerClass="asset-scanner-header"
    actionsClass="asset-scanner-actions"
    closeButtonId="assetScannerClose"
    closeButtonClass="asset-scanner-close"
    closeLabel="Close scanner"
    title="Scan Device QR Code"
    description="Point the camera at the asset tag. The serial will fill in automatically."
  >
      <div class="asset-scanner-video-wrap">
        <video id="assetScannerVideo" class="asset-scanner-video" playsinline autoplay muted></video>
        <div class="asset-scanner-target" aria-hidden="true"></div>
      </div>
      <canvas id="assetScannerCanvas" hidden></canvas>
      <Feedback id="assetScannerStatus" tone="loading" class="asset-scanner-status">Camera starting...</Feedback>
      <Button slot="actions" id="assetScannerCancel" class="asset-scanner-cancel" variant="ghost" type="button" data-ui-dialog-close>Cancel</Button>
  </Dialog>

  <script is:inline src="/vendor/jsQR.min.js"></script>
  <script
    is:inline
    id="inventoryTurnstileScript"
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
    async
    defer
  ></script>
  <script>
    import '../scripts/inventory';
  </script>
</BaseLayout>
