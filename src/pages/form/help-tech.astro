---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Button } from '../../components/ui';
import { iconForm } from '../../scripts/icons';
---
<BaseLayout title="General Technology Help - St. Cecilia Technology" bodyClass="forms-page">
  <meta
    slot="head"
    name="description"
    content="Get help with technology issues at St. Cecilia School"
  />
  <section class="forms-stub">
    <div class="container form-shell">
      <h2>General Technology Help</h2>
      <p>This form is coming soon. For help now, ask your teacher or school technology staff.</p>
      <Button href="/forms" variant="outline" class="page-nav-btn" icon={iconForm}>Back to Forms</Button>
    </div>
  </section>
</BaseLayout>
