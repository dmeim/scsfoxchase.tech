---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Button, Card } from '../../components/ui';
import { iconForm } from '../../scripts/icons';
---
<BaseLayout title="Request A Game - St. Cecilia Technology" bodyClass="forms-page">
  <meta
    slot="head"
    name="description"
    content="Request a new educational game for the St. Cecilia Technology catalog"
  />

  <section class="form-page" aria-labelledby="game-request-title">
    <div class="container form-shell">
      <Card class="form-panel">
        <div class="form-panel-header">
          <h2 id="game-request-title">Request A Game</h2>
        </div>

        <p role="status">Game requests are coming soon. This page cannot send a request yet.</p>
        <p>For now, tell your technology teacher the game's name, website link, and why you would like it added.</p>
        <div class="form-actions"><Button href="/forms" variant="outline" class="page-nav-btn" icon={iconForm}>Back to Forms</Button></div>

      </Card>
    </div>
  </section>


</BaseLayout>
