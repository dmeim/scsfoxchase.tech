---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { iconForm } from '../../scripts/icons';
---
<BaseLayout title="Google/Account Help - St. Cecilia Technology" bodyClass="forms-page">
  <meta
    slot="head"
    name="description"
    content="Get help with Google and school account issues at St. Cecilia School"
  />
  <section class="forms-stub">
    <div class="container form-shell">
      <h2>Google/Account Help</h2>
      <p>This form is coming soon.</p>
      <a href="/forms" class="page-nav-btn">
        <span class="page-nav-btn-icon" set:html={iconForm} />
        Back to Forms
      </a>
    </div>
  </section>
</BaseLayout>
