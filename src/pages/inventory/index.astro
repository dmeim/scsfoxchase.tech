---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { iconPrint, iconQrCode, iconSearch, iconTimes } from '../../scripts/icons';
import '../../styles/inventory.css';
---
<BaseLayout title="Inventory Lookup | St. Cecilia Technology" bodyClass="asset-lookup-page">
  <meta
    slot="head"
    name="description"
    content="St. Cecilia Technology inventory lookup"
  />
  <meta slot="head" name="robots" content="noindex,nofollow" />

  <div class="asset-main">
    <section class="asset-lookup-section" aria-labelledby="asset-lookup-title">
      <div class="container asset-shell">
        <div class="asset-lookup-panel">
          <div class="asset-title-row">
            <div>
              <h2 id="asset-lookup-title">Inventory Report</h2>
              <p class="asset-helper">Enter a device serial number or service tag to pull the matching record.</p>
              <p class="asset-helper">QR tags should store only the serial number as plain text, like <code>ABC123XYZ</code>. Scan, type, or paste that serial here.</p>
            </div>
          </div>

          <form id="assetLookupForm" class="asset-search-form" novalidate>
            <div class="asset-search-controls">
              <input
                id="assetSerialInput"
                class="asset-serial-input"
                type="text"
                name="serial"
                placeholder="Example: ABC123XYZ"
                aria-label="Serial Number / Service Tag"
                autocomplete="off"
                autocapitalize="characters"
                spellcheck="false"
                required
              />
              <button id="assetLookupButton" class="btn asset-lookup-button" type="submit">
                <Fragment set:html={iconSearch} />
                <span>Lookup</span>
              </button>
              <button id="assetScanButton" class="btn asset-scan-button" type="button">
                <Fragment set:html={iconQrCode} />
                <span>Scan QR</span>
              </button>
              <button id="assetPrintButton" class="btn asset-print-button" type="button" disabled>
                <Fragment set:html={iconPrint} />
                <span>Print Report</span>
              </button>
            </div>
          </form>

          <p id="assetConfigNotice" class="asset-config-notice" hidden></p>
        </div>

        <div id="assetMessage" class="asset-message" role="status" aria-live="polite" hidden></div>
        <div id="assetResult" class="asset-result" aria-live="polite" hidden></div>
      </div>
    </section>
  </div>

  <div id="assetScannerModal" class="asset-scanner-modal" hidden>
    <div
      class="asset-scanner-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="assetScannerTitle"
      aria-describedby="assetScannerStatus"
    >
      <div class="asset-scanner-header">
        <div>
          <h2 id="assetScannerTitle">Scan Device QR Code</h2>
          <p>Point the camera at the asset tag. The serial will fill in automatically.</p>
        </div>
        <button id="assetScannerClose" class="asset-scanner-close" type="button" aria-label="Close scanner">
          <Fragment set:html={iconTimes} />
        </button>
      </div>
      <div class="asset-scanner-video-wrap">
        <video id="assetScannerVideo" class="asset-scanner-video" playsinline autoplay muted></video>
        <div class="asset-scanner-target" aria-hidden="true"></div>
      </div>
      <canvas id="assetScannerCanvas" hidden></canvas>
      <p id="assetScannerStatus" class="asset-scanner-status" role="status" aria-live="polite">Camera starting...</p>
      <div class="asset-scanner-actions">
        <button id="assetScannerCancel" class="btn asset-scanner-cancel" type="button">Cancel</button>
      </div>
    </div>
  </div>

  <script is:inline src="/vendor/jsQR.min.js"></script>
  <script>
    import '../../scripts/inventory';
  </script>
</BaseLayout>
