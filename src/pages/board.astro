---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import WhiteboardCanvas from '../components/WhiteboardCanvas';
import '../styles/whiteboard.css';
---
<BaseLayout
  title="Board - St. Cecilia Technology"
  bodyClass="board-page"
  hideFooter={true}
  boardChrome={true}
>
  <meta
    slot="head"
    name="description"
    content="Collaborative whiteboard canvas for St. Cecilia Technology"
  />
  <script slot="head" is:inline>
    window.EXCALIDRAW_ASSET_PATH = '/excalidraw/';
  </script>

  <div class="board-shell">
    <div class="board-canvas-root">
      <WhiteboardCanvas client:only="react" />
    </div>
  </div>

  <script>
    import {
      bindBoardPageScratchClaim,
      readBoardIdFromPath,
    } from '../scripts/whiteboard-library';

    const boardId = readBoardIdFromPath();
    if (!boardId) {
      window.location.replace('/whiteboard');
    } else {
      // One owner for auth/hello-driven scratch claim. Avoid duplicate cloud/DO
      // writes from both the page script and the React island.
      bindBoardPageScratchClaim();
    }
  </script>
</BaseLayout>
