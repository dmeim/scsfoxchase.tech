---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import WhiteboardCanvas from '../components/WhiteboardCanvas';
import '../styles/whiteboard.css';
---
<BaseLayout
  title="Board - St. Cecilia Technology"
  bodyClass="board-page"
  hideFooter={true}
  boardChrome={true}
>
  <meta
    slot="head"
    name="description"
    content="Collaborative whiteboard canvas for St. Cecilia Technology"
  />
  <script slot="head" is:inline>
    window.EXCALIDRAW_ASSET_PATH = '/excalidraw/';
  </script>

  <div class="board-shell">
    <div class="board-canvas-root">
      <WhiteboardCanvas client:only="react" />
    </div>
  </div>

  <script>
    import { whenAuthReady } from '../lib/whiteboard-identity';
    import {
      readBoardIdFromPath,
      touchBoardActive,
    } from '../scripts/whiteboard-library';

    const boardId = readBoardIdFromPath();
    if (!boardId) {
      window.location.replace('/whiteboard');
    } else {
      // Wait for Clerk so signed-in users upsert the cloud library (join does not).
      // WhiteboardCanvas also calls touchBoardActive; duplicate is idempotent upsert.
      void whenAuthReady()
        .then(() => touchBoardActive(boardId))
        .catch(() => {
          // Cloud upsert can fail offline; island touch still runs when signed out.
        });
    }
  </script>
</BaseLayout>
