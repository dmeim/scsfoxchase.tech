---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import TldrawBoard from '../components/TldrawBoard';
import '../styles/whiteboard.css';
---
<BaseLayout
  title="Board - St. Cecilia Technology"
  bodyClass="board-page"
  hideFooter={true}
  boardChrome={true}
>
  <meta
    slot="head"
    name="description"
    content="Collaborative whiteboard canvas for St. Cecilia Technology"
  />

  <div class="board-shell">
    <div class="board-canvas-root">
      <TldrawBoard client:only="react" />
    </div>
  </div>

  <script>
    import { whenAuthReady } from '../lib/whiteboard-identity';
    import {
      readBoardIdFromPath,
      touchBoardActive,
    } from '../scripts/whiteboard-library';

    const boardId = readBoardIdFromPath();
    if (!boardId) {
      window.location.replace('/whiteboard');
    } else {
      // Wait for Clerk to settle so signed-in users don't upsert into local first.
      // TldrawBoard also calls touchBoardActive; duplicate is idempotent upsert.
      void whenAuthReady()
        .then(() => touchBoardActive(boardId))
        .then((entry) => {
          const titleInput = document.querySelector<HTMLInputElement>(
            '[data-wb-manage-title]',
          );
          if (titleInput) titleInput.value = entry.title;
          document.title = `${entry.title} - St. Cecilia Technology`;
        })
        .catch(() => {
          // Cloud upsert can fail offline; island touch still runs when signed out.
        });
    }
  </script>
</BaseLayout>
