---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import HelpSection from '../components/HelpSection.astro';
import { featuredForms, formHref } from '../data/forms';
import {
  iconGamepad2,
  iconWrench,
  iconKeyRound,
  iconBookOpen,
} from '../scripts/icons';
import { getCollection } from 'astro:content';

// Keep the unfinished catalogs off the Help hub until they are ready to publish.
const showDraftSections = false;

const formIcons = {
  iconGamepad2,
  iconWrench,
  iconKeyRound,
} as const;

const formTiles = featuredForms().map((form) => ({
  href: formHref(form.slug),
  label: form.label,
  statusLabel: form.status === 'stub' ? 'Coming soon' : undefined,
  description: form.description,
  iconHtml: formIcons[form.icon],
}));

const featuredGuides = (await getCollection('guides'))
  .filter((g) => g.data.featured)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const guideTiles = featuredGuides.map((g) => ({
  href: `/guide/${g.id}`,
  label: g.data.title,
  description: g.data.description,
  iconHtml: iconBookOpen,
}));
---
<BaseLayout title="Help - St. Cecilia Technology" bodyClass="help-page">
  <meta
    slot="head"
    name="description"
    content="Technology help and Google Classroom links for St. Cecilia School"
  />

  <div class="help-hub">
    <div class="container form-shell">
      <section class="classroom-codes-section" aria-label="Google Classroom Codes">
        <a class="classroom-codes-badge" href="/google-classroom-codes">
          <img
            src="/images/google-classroom-logo-clean.png"
            alt=""
            width="282"
            height="243"
            aria-hidden="true"
          />
          <span>Google Classroom Codes</span>
        </a>
      </section>

      <section class="classroom-codes-section" aria-label="2026 Extra-Curricular Student Survey for grades K-3">
        <a
          class="classroom-codes-badge"
          href="https://docs.google.com/forms/d/e/1FAIpQLSeE6i2-6x8SF3gASDrOHUyvNU9DMN_1kX58iTo_isPy06nvzQ/viewform"
        >
          <img
            src="/images/new-google-forms.svg"
            alt=""
            width="24"
            height="24"
            aria-hidden="true"
          />
          <span>2026 Extra-Curricular Student Survey GR K-3</span>
        </a>
      </section>

      <section class="classroom-codes-section" aria-label="2026 Extra-Curricular Student Survey for grades 4-8">
        <a
          class="classroom-codes-badge"
          href="https://docs.google.com/forms/d/e/1FAIpQLSdIwjdgzW8K3doiG_n_hTd8g9RYfC9KDe140gAuU3WfGguFWA/viewform"
        >
          <img
            src="/images/new-google-forms.svg"
            alt=""
            width="24"
            height="24"
            aria-hidden="true"
          />
          <span>2026 Extra-Curricular Student Survey GR 4-8</span>
        </a>
      </section>

      {showDraftSections && <HelpSection
        title="Forms"
        viewAllHref="/forms"
        tiles={formTiles}
        emptyMessage="No featured forms yet."
        ariaLabel="Featured forms"
      />}

      {showDraftSections && <HelpSection
        title="Guides"
        viewAllHref="/guides"
        tiles={guideTiles}
        emptyMessage="No featured guides yet."
        ariaLabel="Featured guides"
      />}
    </div>
  </div>
</BaseLayout>
