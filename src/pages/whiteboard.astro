---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { Button, Feedback, TextField } from '../components/ui';
import { iconLogIn, iconSquarePlus } from '../scripts/icons';
import '../styles/whiteboard.css';
---
<BaseLayout title="Whiteboard - St. Cecilia Technology" bodyClass="whiteboard-hub-page">
  <meta
    slot="head"
    name="description"
    content="Create, join, and reopen whiteboards for St. Cecilia Technology"
  />

  <section class="wb-hub" data-wb-hub>
    <div class="wb-hub-shell">
      <div class="wb-hub-heading">
        <h2 class="wb-hub-title">Whiteboard</h2>

        <div class="wb-actions">
          <form class="wb-join" data-wb-join>
            <div class="wb-join-fields">
              <div class="wb-join-row">
                <TextField
                  label="Join whiteboard"
                  labelHidden
                  wrapperHidden
                  id="wb-join-input"
                  class="wb-join-field"
                  inputClass="wb-join-input"
                  name="join"
                  data-wb-join-input
                  placeholder="Share code, board link, or UUID"
                  autocomplete="off"
                  spellcheck="false"
                  maxlength="200"
                  hidden
                />
                <Button
                  type="submit"
                  variant="outline"
                  class="wb-join-btn"
                  data-wb-join-button
                  aria-controls="wb-join-input"
                  aria-expanded="false"
                  icon={iconLogIn}
                >
                  Join
                </Button>
              </div>
              <Feedback tone="info" class="wb-join-hint" data-wb-join-hint hidden />
            </div>
          </form>

          <div class="wb-create">
            <Button type="button" class="wb-create-btn" data-wb-create icon={iconSquarePlus}>Create</Button>
            <Feedback tone="error" class="wb-join-hint" data-wb-create-hint hidden />
          </div>
        </div>
      </div>

      <p class="wb-hub-lede">
        Create a board for class or group work, or join with a share code, link,
        or UUID. Sign in with Google to save boards to your library and reopen
        them on any Chromebook.
      </p>

      <div data-wb-cloud-lists hidden>
        <section class="wb-section" aria-labelledby="wb-recents-heading">
          <h3 id="wb-recents-heading" class="wb-section-title">Recents</h3>
          <p class="wb-section-empty" data-wb-recents-empty>
            No recent boards in your Google library yet. Create one to get started.
          </p>
          <div class="wb-card-grid wb-card-grid--recents" data-wb-recents-grid hidden></div>
        </section>

        <section class="wb-section wb-section--assets" hidden aria-labelledby="wb-assets-heading">
          <h3 id="wb-assets-heading" class="wb-section-title">Assets</h3>
          <p class="wb-section-empty" data-wb-assets-empty>
            Files you add on a board stay on that board. This list is not a class media library.
          </p>
          <div class="wb-asset-row" data-wb-assets-row hidden></div>
        </section>

        <section class="wb-section" aria-labelledby="wb-library-heading">
          <h3 id="wb-library-heading" class="wb-section-title">Library</h3>
          <p class="wb-section-empty" data-wb-library-empty>
            Boards you create while signed in are saved here automatically.
          </p>
          <div class="wb-card-grid" data-wb-library-grid hidden></div>
        </section>
      </div>

      <p class="wb-hub-note" data-wb-hub-note>
        Create works without an account. That scratch board stays live if you
        refresh, but it is not in a library and is removed after 24 hours if it
        is never saved. Join by code or link also works signed out. Sign in with
        Google to Save and keep Recents and Library.
      </p>
    </div>
  </section>

  <script>
    import '../scripts/whiteboard-hub';
  </script>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Hidden until canvas PUT upserts assets.json — not a class media library. */
  .wb-section--assets {
    display: none;
  }
</style>
