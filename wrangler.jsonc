{
  "name": "scsfoxchase-tech",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  // Ensure workers.dev route is published (DNS must resolve for preview)
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  // Custom entry: Astro handler + /api/whiteboard/* (Durable Objects)
  "main": "./src/worker.ts",
  "triggers": {
    "crons": ["17 * * * *"]
  },
  // Astro emits client assets under dist/client/ (Worker code bundled by Cloudflare Vite plugin)
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // Missing assets must 404 — never SPA-fallback HTML onto CSS (breaks under nosniff)
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  // -------------------------------------------------------------------------
  // Whiteboards (product resource family: scsfoxchase-tech_whiteboards)
  // Binding WHITEBOARDS → Durable Object class WhiteboardBoard (SQLite-backed)
  // Binding WHITEBOARD_ASSETS → R2 bucket scsfoxchase-tech-whiteboards
  //   R2 bucket names cannot contain `_`; hyphenated name maps to the family.
  //   Historical read-only migration/recovery sources: library/{ownerKey}/boards.json|assets.json
  // Binding WHITEBOARD_CODES → KV share-code → boardId (permanent per board)
  // Clerk secrets (not in this file):
  //   npx wrangler secret put CLERK_SECRET_KEY
  // Admin wipe (not in this file):
  //   npx wrangler secret put WHITEBOARD_ADMIN_SECRET
  //   Workers Builds / dashboard vars: PUBLIC_CLERK_PUBLISHABLE_KEY,
  //     PUBLIC_CLERK_ALLOWED_DOMAINS (optional)
  //   Local: .dev.vars (see .dev.vars.example)
  // -------------------------------------------------------------------------
  "durable_objects": {
    "bindings": [
      {
        "name": "WHITEBOARDS",
        "class_name": "WhiteboardBoard"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "WHITEBOARD_CONNECT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "migrations": [
    {
      "tag": "whiteboard-v1",
      "new_sqlite_classes": ["WhiteboardBoard"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "WHITEBOARD_ASSETS",
      "bucket_name": "scsfoxchase-tech-whiteboards"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WHITEBOARD_CODES",
      "id": "4d5a29d9dfbf424f82e000571a8d917c",
      "preview_id": "ef457d2000b94d8faba302321df01faa"
    }
  ],
  // D1 stores signed-in Whiteboard Library / Recents / Assets metadata only.
  // Durable Object SQLite remains the scene store and R2 remains the media/
  // preview store. Wrangler uses the preview database for remote dev so a
  // preview session cannot accidentally write production library metadata.
  "d1_databases": [
    {
      "binding": "WHITEBOARD_LIBRARY",
      "database_name": "scsfoxchase-tech-whiteboard-library",
      "database_id": "b291f64a-65d7-49cf-a96a-cb6787463d0a",
      "preview_database_id": "7b476947-1004-41b5-8645-4d7645c6262e",
      "migrations_dir": "./migrations"
    },
    {
      "binding": "NOTIFICATIONS",
      "database_name": "scsfoxchase-tech-notifications",
      "database_id": "ba58b8e0-e88f-4803-ad51-3f257288fc50",
      "preview_database_id": "7dd4b16c-95d8-49b8-b44b-24c3c119619e",
      "migrations_dir": "./notification-migrations"
    }
  ]
}
