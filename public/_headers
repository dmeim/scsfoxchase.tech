# Security headers — single source of truth for Cloudflare (Astro public/)
# Cache: max-age ≤ 3600 everywhere (never immutable). Long immutable TTLs on
# /_astro/* previously cached 404s for a year when CSS was briefly missing.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  # tldraw loads icons/fonts/translations from https://cdn.tldraw.com by default
  # (mask images → img-src; woff2 → font-src; en.json fetch → connect-src).
  # worker-src blob: covers any blob workers tldraw may spawn.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://cdn.tldraw.com; img-src 'self' data: blob: https://cdn.tldraw.com; connect-src 'self' https://cloudflareinsights.com https://*.n8n.cloud https://n8n.mlabz.io https://cdn.tldraw.com; worker-src 'self' blob:
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: public, max-age=3600, must-revalidate

/inventory
  X-Robots-Tag: noindex, nofollow

/inventory/*
  X-Robots-Tag: noindex, nofollow
