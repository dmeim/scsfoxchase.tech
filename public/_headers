# Security headers — single source of truth for Cloudflare (Astro public/)
# Cache: max-age ≤ 3600 everywhere (never immutable). Long immutable TTLs on
# /_astro/* previously cached 404s for a year when CSS was briefly missing.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  # tldraw loads icons/fonts/translations from https://cdn.tldraw.com by default
  # (mask images → img-src; woff2 → font-src; en.json fetch → connect-src).
  # worker-src blob: covers any blob workers tldraw may spawn.
  # connect-src 'self' covers same-origin WebSocket (/api/whiteboard/connect/*)
  # and same-origin asset PUT/GET (/api/whiteboard/assets/*).
  # img-src / media-src 'self' cover resolved R2 asset URLs under /api/whiteboard/assets/*
  # Clerk custom FAPI/Accounts + Turnstile (sign-up captcha) + Google One Tap/OAuth frames.
  # Guide source chips load favicons via Google s2 (often served from *.gstatic.com).
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://clerk.scsfoxchase.tech https://accounts.scsfoxchase.tech https://*.clerk.accounts.dev https://challenges.cloudflare.com https://accounts.google.com 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://cdn.tldraw.com; img-src 'self' data: blob: https://cdn.tldraw.com https://img.clerk.com https://*.googleusercontent.com https://www.google.com https://*.gstatic.com https://challenges.cloudflare.com; media-src 'self' data: blob:; connect-src 'self' https://cloudflareinsights.com https://*.n8n.cloud https://n8n.mlabz.io https://cdn.tldraw.com https://clerk.scsfoxchase.tech https://accounts.scsfoxchase.tech https://*.clerk.accounts.dev https://api.clerk.com https://clerk-telemetry.com https://challenges.cloudflare.com https://accounts.google.com; frame-src 'self' https://clerk.scsfoxchase.tech https://accounts.scsfoxchase.tech https://*.clerk.accounts.dev https://accounts.google.com https://challenges.cloudflare.com; worker-src 'self' blob:
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: public, max-age=3600, must-revalidate

/inventory
  X-Robots-Tag: noindex, nofollow

/inventory/*
  X-Robots-Tag: noindex, nofollow
