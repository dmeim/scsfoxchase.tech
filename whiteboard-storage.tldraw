    {
      "id": "shape:takeaways",
      "typeName": "shape",
      "type": "geo",
      "x": 200,
      "y": 2960,
      "rotation": 0,
      "isLocked": false,
      "opacity": 1,
      "parentId": "page:page",
      "index": "auKKr",
      "meta": {},
      "props": {
        "geo": "rectangle",
        "url": "",
        "w": 1600,
        "h": 180,
        "labelColor": "black",
        "color": "yellow",
        "fill": "solid",
        "dash": "solid",
        "size": "m",
        "font": "sans",
        "align": "middle",
        "verticalAlign": "middle",
        "growY": 0,
        "scale": 1,
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "TAKEAWAYS"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "• Drawing (document) → ALWAYS Durable Object SQLite (tldraw_*) — never local, never R2"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "• Uploaded files → ALWAYS R2 assets/{ownerKey}/{assetId} — ownerKey flips local: vs google:"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "• Hub Recents/Library/Assets → localStorage when signed out · R2 library/google:…/*.json when signed in"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "• Host secret stays in this browser’s localStorage either way · DO room is shared by anyone with the board UUID/code"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "• Sign-in swaps which index you see — it does not migrate or delete the other namespace"
                }
              ]
            }
          ]
        }
      }
    },
