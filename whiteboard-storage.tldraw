              "content": [
                {
                  "type": "text",
                  "text": "8. Draw — document persists here"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "TLSocketRoom + SQLiteSyncStorage"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "DO SQLite tables tldraw_*"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "First hostSecret → meta:hostSecretHash"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "ALWAYS cloud · same for everyone on this UUID"
                }
              ]
            }
          ]
        }
      }
    },
